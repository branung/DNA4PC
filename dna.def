tilefromtexture 2538 { file "tiles/2538.png" xoffset 15 yoffset 11 }
tilefromtexture 2539 { file "tiles/2539.png" xoffset 15 yoffset 11 }
tilefromtexture 2540 { file "tiles/2540.png" xoffset 15 yoffset 11 }
