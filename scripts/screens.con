    addvar y 10
    screentext DNASMALLTEXT x y 75536 0 0 153 0 0 16 0 4 0 0 0 2 0 0 xdim ydim
    addvar y 20
    screentext DNASMALLTEXT x y 75536 0 0 154 0 0 16 0 4 0 0 0 2 0 0 xdim ydim
    addvar y 10
    screentext DNASMALLTEXT x y 75536 0 0 155 0 0 16 0 4 0 0 0 2 0 0 xdim ydim
    addvar y 10
    screentext DNASMALLTEXT x y 75536 0 0 156 0 0 16 0 4 0 0 0 2 0 0 xdim ydim
    addvar y 10
