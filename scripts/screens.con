defstate display_logo
{
    ifn curr_logo 0 { rotatesprite 160 100 LOGO_SIZE 0 curr_logo 0 0 72 0 0 xdim ydim  }
    ifvarg SCREENALPHA 0
    {
        state screen_fadeout
    }
    ifvarg delayTime 0
    {
        state cutscene_timer
    }
    else
    {
        addvar in_startup 1
    }
}
ends

defstate fade_logo
{
    ifn curr_logo 0 { rotatesprite 160 100 LOGO_SIZE 0 curr_logo 0 0 72 0 0 xdim ydim  }
         
    ifvarl SCREENALPHA 255
    {
        state screen_fadein
    }
    else {
        setvar prevtick -1
        setvar SCREENALPHA 255
        setvar delayTime LOGO_DELAY_TIME
        setvar RETURN 1
    }
}
ends

defstate show_logos {
    switch in_startup
    case 1 {
        sound GBA_INTRO
        startcutscene 149 // logo.ivf
        stopallmusic
        starttrackslot 7 0 
        addvar in_startup 1
        break
    }
    case 2 {
        stopallsounds
        state display_copyright_screen
        set curr_logo 0
        state display_logo
        break
    }
    case 3
    {
        state display_copyright_screen
        state fade_logo
        break
    }
    case 4 {
        set curr_logo LOGO_3DR
        state display_logo
        break
    }
    case 5
    {
        state fade_logo
        break
    }
    case 6 {
        
        set curr_logo LOGO_TAKETWO
        state display_logo
        break
    }
    case 7
    {
        state fade_logo
        break
    }
    case 8
    {
        set curr_logo LOGO_TORUS
        state display_logo
        break
    }
    case 9
    {
        state fade_logo
        break
    }
    endswitch
}
ends

defstate get_title_ticks {
    getticks curtick
    ifvare prevtick -1 setvar ticktmp 0 else
    {
    setvarvar ticktmp curtick
    subvarvar ticktmp prevtick
    }
    ifl title_ani 3 { divvar ticktmp 3 }
    else divvar ticktmp 2
}
ends



// Timer for Press Start sprite on main menu
// Reuses delaytimers from end level screen since there wouldn't be any chance of conflict
defstate press_start_title_ani {
    ifvarg bonusDelayTime 0
    {
        getticks curtick
        ifvare bonus_screen_prevtick -1 setvar ticktmp 0 else
        {
            setvarvar ticktmp curtick
            subvarvar ticktmp bonus_screen_prevtick
        }
        divvar ticktmp 4      
        subvarvar bonusDelayTime ticktmp           
        setvarvar bonus_screen_prevtick curtick
    }
    else
    {
        switch press_start_ani { // Messy switch to avoid making several redundant tiles for animation
            case 0 
            case 10 set curr_ps_sprite PRESS_START_START break
            case 1 
            case 9 set curr_ps_sprite 5556 break
            case 2 
            case 8 set curr_ps_sprite 5557 break
            case 3
            case 4
            case 5
            case 6
            case 7 set curr_ps_sprite 5558 break
            case 11
            case 20 set curr_ps_sprite 5559 break
            case 12 
            case 19 set curr_ps_sprite 5560 break
            case 13 
            case 17 
            case 18 set curr_ps_sprite 5561 break
            case 14 
            case 15 
            case 16 set curr_ps_sprite 5562 break
        endswitch
        }
        ifl press_start_ani 20 { add press_start_ani 1 } else set press_start_ani 0
        setvar bonusDelayTime 7 // Change this to adjust animation speed
    }
}
ends

defstate show_title {
    switch in_startup
    case 10 
    {
        rotatesprite 160 100 LOGO_SIZE 0 TITLE_BACKGROUND 0 0 72 0 0 xdim ydim
        ifvarg SCREENALPHA 0
        {
            state screen_fadeout
        }
        else 
        switch title_ani 
        case 1
        {
            ifvarl duke_title_slidein_time TITLE_DUKE_FINAL_POSX  
            {
                state get_title_ticks
                
                addvarvar duke_title_slidein_time ticktmp
                
                setvarvar prevtick curtick
            }
            else 
            {
                addvar title_ani 1
                sound A_EXPLOSION
            }
            break
        }
        case 2
        {
            ifvarg nukem_title_slidein_time TITLE_NUKEM_MID_POSX  
            {
                state get_title_ticks
                subvarvar nukem_title_slidein_time ticktmp
                ifvarl nukem_title_slidein_time TITLE_NUKEM_FINAL_POSX
                {
                    subvarvar duke_title_slidein_time ticktmp
                }
                
                setvarvar prevtick curtick
            }
            else
            {
                addvar title_ani 1
                sound A_EXPLOSION
            }
            break
        }
        case 3
        {
            ifvarl duke_title_slidein_time TITLE_DUKE_FINAL_POSX  
            {
                state get_title_ticks
                
                addvarvar duke_title_slidein_time ticktmp
                ifvarl nukem_title_slidein_time TITLE_NUKEM_FINAL_POSX
                {
                    addvarvar nukem_title_slidein_time ticktmp
                }
                
                setvarvar prevtick curtick
            }
            else 
            { 
                setvar duke_title_slidein_time TITLE_DUKE_FINAL_POSX 
                setvar nukem_title_slidein_time TITLE_NUKEM_FINAL_POSX  
                addvar title_ani 1
            }
            break
        }
        case 4
        {
            ifvarg advance_slideup_time TITLE_ADVANCE_MID_POSY  
            {

                state get_title_ticks
                subvarvar advance_slideup_time ticktmp

                ifvarl advance_slideup_time TITLE_ADVANCE_FINAL_POSY
                {
                    subvarvar name_title_slideup_time ticktmp
                }
                
                setvarvar prevtick curtick
            }
            else
            {
                addvar title_ani 1
                sound A_EXPLOSION
            }
            break
        }
        case 5
        {
            ifvarl advance_slideup_time TITLE_ADVANCE_FINAL_POSY  
            {
                state get_title_ticks
                addvarvar advance_slideup_time ticktmp
                ifvarl name_title_slideup_time TITLE_DUKENUKEM_FINAL_POSY
                {
                    addvarvar name_title_slideup_time ticktmp
                }
                
                setvarvar prevtick curtick
            }
            else
            {
                sound ALIENLORDROAM
                setvar name_title_slideup_time TITLE_DUKENUKEM_FINAL_POSY 
                setvar advance_slideup_time TITLE_ADVANCE_FINAL_POSY
                addvar title_ani 1
            }
            break
        }
        case 6
        {
            state get_title_ticks
            state press_start_title_ani
            rotatespritea 160 192 81935 0 curr_ps_sprite 0 0 8 0 0 0 xdim ydim
            setvarvar prevtick curtick
            break
        }
        endswitch
        rotatesprite duke_title_slidein_time name_title_slideup_time 81935 0 TITLE_DUKE 0 0 8 0 0 xdim ydim
        rotatesprite nukem_title_slidein_time name_title_slideup_time 81935 0 TITLE_NUKEM 0 0 8 0 0 xdim ydim
        rotatesprite 160 advance_slideup_time 81935 0 TITLE_ADVANCE 0 0 8 0 0 xdim ydim
        break
    }
    case 11
    {
        rotatesprite 160 100 LOGO_SIZE 0 TITLE_BACKGROUND 0 0 8 0 0 xdim ydim
        rotatesprite duke_title_slidein_time name_title_slideup_time 81935 0 TITLE_DUKE 0 0 8 0 0 xdim ydim
        rotatesprite nukem_title_slidein_time name_title_slideup_time 81935 0 TITLE_NUKEM 0 0 8 0 0 xdim ydim
        rotatesprite 160 advance_slideup_time 81935 0 TITLE_ADVANCE 0 0 8 0 0 xdim ydim
        ife title_ani 6 { rotatespritea 160 192 81935 0 curr_ps_sprite 0 0 8 0 0 0 xdim ydim }

        ifvarl SCREENALPHA 255
        {
            state screen_fadein
        }
        else set RETURN 1
        break
    }
    endswitch
}
ends

appendevent EVENT_SCREEN
{
    ifg in_startup 0 {
        state setsqraspect
        ifle in_startup 9 state show_logos
        ifge in_startup 10 state show_title
        state setdosaspect
    }
}
endevent

defstate startup_cleanup // Reset values when back at startup
{
    set in_startup 1
    set title_ani 1
    set press_start_ani 0
    set curr_ps_sprite PRESS_START_START
    set in_opening_cutscene 0
    set in_endlevel_screen 0
    set in_ending_cutscene 0
    set duke_title_slidein_time TITLE_DUKE_START_POSX
    set nukem_title_slidein_time TITLE_NUKEM_START_POSX
    set name_title_slideup_time TITLE_DUKENUKEM_FINAL_POSY
    set advance_slideup_time TITLE_ADVANCE_START_POSY
}
ends

appendevent EVENT_MAINMENUSCREEN
{
    state startup_cleanup
    setvar delayTime LOGO_DELAY_TIME
    whilel in_startup 11 {
        startscreen
        addvar in_startup 1
    }
    sound A_PISTOL
    startscreen
    setvar in_startup 0
}
endevent

// Timer for DIG skull panel
// Reuses delaytimers from end level screen since there wouldn't be any chance of conflict
defstate skull_panel_ani {
    ifvarg bonusDelayTime 0
    {
        getticks curtick
        ifvare bonus_screen_prevtick -1 setvar ticktmp 0 else
        {
            setvarvar ticktmp curtick
            subvarvar ticktmp bonus_screen_prevtick
        }
        divvar ticktmp 4      
        subvarvar bonusDelayTime ticktmp           
        setvarvar bonus_screen_prevtick curtick
    }
    else
    {
        ife skull_skill_ani 0 { 
            set curr_skull SKULL_SKILL_START
            set skull_skill_ani 1
        }
        else ife curr_skull SKULL_SKILL_END set curr_skull SKULL_SKILL_START
        else { add curr_skull 1 }
        setvar bonusDelayTime 20 // Change this to adjust skull animation speed
    }
}
ends


appendevent EVENT_DISPLAYMENUREST
    switch userdef.return 0
        // newgame custom 1st level
        case 102:
            // Reset the nukesymbol override if we're in any other menu than skill
            // Each print mostly gets the current slide and then just does gametext where needed.
            set m_at_skill 0
            redefinequote 200 CHOOSE STYLE
            getu[].return 1 temp
            shiftvarr temp 16
            qstrdim temp2 temp3 DNASMALLTEXT 0 50 65536 0 200 16 8 0 0 0 0 0 0 xdim ydim
            div temp2 2
            add temp 160
            sub temp temp2
            add temp 1
            screentext DNASMALLTEXT temp 44 65536 0 0 200 32 0 16 0 8 0 0 0 0 0 0 xdim ydim
            sub temp 1
            screentext DNASMALLTEXT temp 43 65536 0 0 200 0 0 16 0 8 0 0 0 0 0 0 xdim ydim
    
            getu[].return 3 temp
            ife temp 0 redefinequote 200 Apply map shading and minor QoL tweaks.
            ife temp 1 redefinequote 200 Match the GBA original.
            getu[].return 1 temp
            shiftvarr temp 16
            qstrdim temp2 temp3 STARTALPHANUM 0 50 49152 0 200 16 8 0 0 0 0 0 0 xdim ydim
            div temp2 2
            add temp 160
            sub temp temp2
            screentext STARTALPHANUM temp 115 49152 0 0 200 0 0 16 0 8 0 0 0 0 0 0 xdim ydim
            
            getu[].return 3 temp
            ife temp 0 redefinequote 200 This is the recommended way to play.
            ife temp 1 redefinequote 200 Aims for a more vanilla experience.
            getu[].return 1 temp
            shiftvarr temp 16
            qstrdim temp2 temp3 STARTALPHANUM 0 50 49152 0 200 16 8 0 0 0 0 0 0 xdim ydim
            div temp2 2
            add temp 160
            sub temp temp2
            screentext STARTALPHANUM temp 121 49152 0 0 200 0 0 16 0 8 0 0 0 0 0 0 xdim ydim
            
    
            redefinequote 200 CUSTOMIZE MORE IN-GAME WITH [BACKSPACE]
            getu[].return 1 temp
            shiftvarr temp 16
            qstrdim temp2 temp3 DNASMALLTEXT 0 50 49152 0 200 16 8 0 0 0 0 0 0 xdim ydim
            div temp2 2
            add temp 160
            sub temp temp2
            screentext DNASMALLTEXT temp 178 49152 0 0 200 8 0 16 0 8 0 0 0 0 0 0 xdim ydim
            break
        // MENU: At skill
        case 110:
            // This variable tracks whether to hide the nuke symbols in other events
            set m_at_skill 1
            
            // X = Start at 80, get the transition X scroll amount from userdef 1
            set m_draw_x 80
            getu[].return 1 temp
            shiftvarr temp 16
            add m_draw_x temp
            // Hardcode Y to be here
            set m_draw_y 90
            // Get currently selected skill and bump the minimum from 0 to 1
            getu[].return 3 temp2
            add temp2 1
            // For loop for all 4 skills, determine what tile to draw and quote
            for i range 4 {
                add i 1
                switch i
                    case 1:
                        ife temp2 i {
                            set temp 7000
                            redefinequote 200 PISS OF CAKE
                        } else set temp 7001
                        
                        break
                    case 2:
                        ife temp2 i {
                            set temp 7002
                            redefinequote 200 LETS KNOCK
                        } else set temp 7003
                        
                        break
                    case 3:
                        ife temp2 i {
                            set temp 7006
                            redefinequote 200 COME GET SUN
                        } else set temp 7007
                        
                        break
                    case 4:
                        ife temp2 i {
                            state skull_panel_ani
                            set temp curr_skull 
                            redefinequote 200 DAMN IM GOD
                        } else { set temp 7016 set skull_skill_ani 0 }
                        break
                endswitch
                // Draw the current picture frame
                rotatesprite m_draw_x m_draw_y 65536 0 temp 0 0 8 0 0 xdim ydim
                // Draw the selection blinker if current iterated skill is the selected one
                ife temp2 i {
                    ifg m_anim_frames 15 {
                        rotatesprite m_draw_x m_draw_y 65536 0 7004 0 0 8 0 0 xdim ydim
                    } else {
                        rotatesprite m_draw_x m_draw_y 65536 0 7005 0 0 8 0 0 xdim ydim
                    }
                }
                // Add 54px after each portrait that gets iterated
                add m_draw_x 54
            }
            // Now we draw the text box
            // Get the X coords and transition scroll as usual
            set m_draw_x 160
            getu[].return 1 temp
            shiftvarr temp 16
            add m_draw_x temp
            // Y coords and set the tilenum
            set m_draw_y 160
            set temp 5539
            rotatesprite m_draw_x m_draw_y 65536 0 temp 0 0 8 0 0 xdim ydim
            // Box done, let's do the text now and get it's length
            qstrdim temp2 temp3 DNABIGTEXTBRIGHT 0 50 65536 0 200 8 8 0 0 0 0 0 0 xdim ydim
            div temp3 2
            div temp2 2
            sub m_draw_x temp2
            sub m_draw_y temp3
            sub m_draw_y 1
            sub m_draw_x 8
            // Where we want to put it is pretty much same as the box coords, given lengths divided by two. Slight padding.
            screentext DNABIGTEXTBRIGHT m_draw_x m_draw_y ENDSCREEN_TEXT_SIZE 0 0 200 0 0 16 0 4 0 0 0 0 0 0 xdim ydim
            
            // Track animation for 1->30 (~1s) needs something better!
            add m_anim_frames 1
            ifg m_anim_frames 30 set m_anim_frames 1
            
            break
        default:
            // Reset the nukesymbol override if we're in any other menu than skill
            set m_at_skill 0
            break
    endswitch
endevent

appendevent EVENT_MENUCURSORLEFT
    ife m_at_skill 1 set RETURN -1
endevent

appendevent EVENT_MENUCURSORRIGHT
    ife m_at_skill 1 set RETURN -1
endevent

appendevent EVENT_NEWGAMECUSTOM
    switch userdef.return 0
        case 0
            setu[].m_volume_number 0
            setu[].m_level_number 0
            redefinequote 200 ENHANCED SELECTED
            quote 200
            break
        case 1
            setu[].m_volume_number 0
            setu[].m_level_number 0
            redefinequote 200 VANILLA SELECTED
            quote 200
            break
    endswitch
endevent

