defstate get_credit_ticks {
    ifvarg delayTime 0
    {
        getticks curtick
        ifvare credits_screen_prevtick -1 setvar ticktmp 0 else
        {
        setvarvar ticktmp curtick
        subvarvar ticktmp credits_screen_prevtick
        }

        subvarvar delayTime ticktmp
        
        setvarvar credits_screen_prevtick curtick
    }
    else {
        subvarvar credits_slideup_time 1
        set delayTime 50
    }
}
ends

// Timer for company panel closing and opening
// Reuses bonus screen prevtick and delaytime to avoid conflicts
defstate credits_screen_ani {
    ifvarg bonusDelayTime 0
    {
        getticks curtick
        ifvare bonus_screen_prevtick -1 setvar ticktmp 0 else
        {
            setvarvar ticktmp curtick
            subvarvar ticktmp bonus_screen_prevtick
        }

        divvar ticktmp 4
        
        subvarvar bonusDelayTime ticktmp
            
        setvarvar bonus_screen_prevtick curtick
    }
    else
    {
        ife credits_panel_ani 0 { add curr_panel 1 }
        else { sub curr_panel 1 }
        ife curr_panel CREDITS_PANEL_CLOSED { set credits_panel_ani 1 }
        else ife curr_panel CREDITS_PANEL { set credits_panel_ani 0 add credits_ani 1 } 
        setvar bonusDelayTime LEVEL_COMPLETE_ANI_DELAY
    }
}
ends

defstate print_credit_title {
    add temp CREDITS_INDIVIDUAL_GAP
    ifg temp 20
    screentext DNASMALLTEXT x temp 75536 0 0 CREDITS_QUOTE 0 0 16 0 4 0 0 0 2 0 0 xdim ydim
}
ends

defstate print_credit_title_line2 {
    add temp CREDITS_TITLENAME_GAP
    ifg temp 20
    screentext DNASMALLTEXT x temp 75536 0 0 CREDITS_QUOTE 0 0 16 0 4 0 0 0 2 0 0 xdim ydim
}
ends

defstate print_credit_name {
    add temp CREDITS_TITLENAME_GAP
    ifg temp 20
    screentext DNASMALLTEXT x temp 75536 0 0 CREDITS_QUOTE 10 0 16 0 4 0 0 0 2 0 0 xdim ydim
}
ends

