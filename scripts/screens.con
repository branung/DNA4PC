    setvar x 49
    rotatesprite x 178 PLAY_BUTTON_SIZE 0 5759 0 0 8 0 0 xdim ydim
    screentext DNABIGTEXTBRIGHT 21 170 76536 0 0 141 0 0 16 0 8 0 ENDSCREEN_TEXT_SPACE 0 16 0 0 xdim ydim

