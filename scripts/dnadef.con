gamevar INV_NUM_TEMP 0 2

gamevar SCREENSIZE -1 1

//gamevar for checking music before playing cutscene
gamevar currmusic 0

//Delay vars
var delayTime 0

gamevar prevtick -1 0
gamevar curtick   0 0
gamevar ticktmp   0 0 
gamevar ticktmp2  0 0

defineprojectile GREYPROJECTILE PROJ_WORKSLIKE 32770
