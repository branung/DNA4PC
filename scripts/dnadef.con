//setdefname dna.def

gamevar dna_localization 0 // 0 is the US script. run 'setvar dna_localization 1' in console while ingame for the EU localization
gamevar dna_dukecutscenevoc 0 // 0 means no Duke voice lines play in cutscenes, 1 means 3D voice clips are played, 2 means Gianni voice lines are used
gamevar dna_menu_tutorial 0 

// Enemies and their projectiles
define GREY 5119
define GREYSTRENGTH 80
define GREYPROJECTILE 5165
define GREYREVIVEPROJECTILE 5167
define GREYPROJECTILESTRENGTH 15
define GREYPROJECTILEREVIVEXY 500
define GREYPROJECTILEREVIVEZ 20000
