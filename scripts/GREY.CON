//============================================================
// GREY REVIVE PROJECTILE CODE - Grey code located below this 
//============================================================

var REVIVEDISTANCE 20000

gamevar reviveFound -1 2
gamevar reviveID -1 0 
gamevar targetLoop 0 2
gamevar angx 0 2
gamevar angy 0 2
gamevar angz 0 2
gamevar targetAng 0 2
gamevar reviveZ 0 2
//gamevar targetZ 0 2

// Revive projectile actor defines
// Grey's will prioritize case 0, each following case gets next dibs
// So you can organize the cases here based on which enemies you want them to target first
state getReviveEnemy {
  switch targetLoop {
    case 0 findnearactor LIZMAN REVIVEDISTANCE reviveFound break 
    case 1 findnearactor PIGCOP REVIVEDISTANCE reviveFound break 
    case 2 findnearactor LIZTROOP REVIVEDISTANCE reviveFound break 
    case 3 findnearactor OCTABRAIN REVIVEDISTANCE reviveFound break 
    case 4 findnearactor GREY REVIVEDISTANCE reviveFound break 
    case 5 findnearactor SLIMECRAB REVIVEDISTANCE reviveFound break
    case 6 findnearactor SLIMEREGG REVIVEDISTANCE reviveFound break
  }
  endswitch
}
ends

state checkGreyRevive {
  ife reviveFound -1 {
    whilel targetLoop 7 {
      state getReviveEnemy
      ifn reviveFound -1 { 
        geta[reviveFound].extra temp
        ife temp 0 {
          geta[THISACTOR].z temp2
          sub temp2 9000 // sets actors cansee height to around the Grey's eye height, so he can see :D
          cansee sprite[THISACTOR].x sprite[THISACTOR].y temp2 sprite[THISACTOR].sectnum
          sprite[reviveFound].x sprite[reviveFound].y sprite[reviveFound].z sprite[reviveFound].sectnum temp
          ife temp 1 {
                set targetLoop 10
              } else {
          set reviveFound -1
          } 
        }
        else {
          set reviveFound -1
        } 
      }
      add targetLoop 1
    }
  }
}
ends

eventloadactor GREYREVIVEPROJECTILE
    seta .cstat 0
enda

move REVPROJVEL 300
action  GREYREVPROJSHOOT         0   3  3  1  22

ai PROJCHECK GREYREVPROJSHOOT 0
ai PROJSHOOT GREYREVPROJSHOOT REVPROJVEL

useractor notenemy GREYREVIVEPROJECTILE GREYPROJECTILESTRENGTH 
  ifaction 0 {
    seta .xrepeat 26
    seta .yrepeat 26
    set targetLoop 0
    ifn reviveID -1 { set reviveFound reviveID } else killit
    set reviveID -1
    ai PROJCHECK
    }
    ifai PROJCHECK {
        ifcount 1 {
            geta[reviveFound].extra temp
            ife temp 0
            {
              getactor[reviveFound].x angx
              getactor[reviveFound].y angy
              subvarvar angx sprite[THISACTOR].x
              subvarvar angy sprite[THISACTOR].y
              getangle targetAng angx angy

              seta[THISACTOR].ang targetAng

              getactor[reviveFound].z angz
              subvarvar angz sprite[THISACTOR].z
              shiftvarr angz 4

              ldist temp2 THISACTOR reviveFound
              getangle targetAng temp2 angz
              
              seta[THISACTOR].zvel targetAng

              ai PROJSHOOT
            } else killit
        } 
    }
    ifai PROJSHOOT {
        geta[].ang targetAng
        cos xvel targetAng
	      sin yvel targetAng
        shiftvarr xvel 6
        shiftvarr yvel 6
        
        geta[].zvel reviveZ
        cos zvel reviveZ
        shiftvarr zvel 3

        getactor[reviveFound].z angz
        sub angz 20
        geta[].z reviveZ

        ifg reviveZ angz { mul zvel -1 set angy 1 } //angy from last ai process used to store temp value telling proj not to keep switching up and down
        else ifn angy 1 abs zvel else set zvel 0
        
        movesprite THISACTOR xvel yvel zvel 0 temp
        //addlogvar temp
        ifge temp 32768 { ifl temp 49152 { killit } } // Kill if hits wall
        geta[reviveFound].extra temp 
        ifn temp 0 killit // Kill if target enemy is no longer dead 
        //ifcount 40 killit
    }
enda

//==================
// GREY ENEMY CODE
//==================

actor GREYPROJECTILE GREYPROJECTILESTRENGTH enda

spriteflags GREY 4194304

action GREYWALKING          0   3  5  1  22
action GREYSTANDING         16  1  5  1  10
action GREYATTACKING        23  4  1  1  30
action GREYREVIVING         28  5  1  1  20
action GREYDYING            39  5  1  1  8
action GREYDEADBODY         43  1  1  1  10
action GREYFROZEN           0   1  5  1  10
action GREYFLINCH           33  1  5  1  10
action GREYGROW             0   1  1  1  10

move GREYSTOPPED
move GREYWALKVEL 132
move GREYSHRUNKVELS 32

gamevar greyprojpos 0 0
gamevar greycurrpos 0 0

ai AIGREYWAIT               GREYSTANDING GREYSTOPPED geth
ai AIGREYSEEK               GREYWALKING GREYWALKVEL seekplayer
ai AIGREYATTACKPLAYER       GREYATTACKING GREYSTOPPED faceplayer
ai AIGREYREVIVING           GREYREVIVING GREYSTOPPED faceplayer //figure out direction for this
ai AIGREYDYING	            GREYDYING GREYSTOPPED geth
ai AIGREYHIT                GREYFLINCH GREYSTOPPED faceplayer
ai AIGREYFROZEN             GREYFROZEN GREYSTOPPED geth
ai AIGREYSHRUNK             GREYWALKING GREYSHRUNKVELS fleeenemy
ai AIGREYGROW               GREYGROW GREYSTOPPED geth

state greyhitstate
        ifcount 9 ai AIGREYWAIT
ends

state greywaitstate
	ifcount 30 ai AIGREYSEEK
ends

state greyseekstate
       ifcansee ifpdistl 6144
        ifrnd 2
        {
			// add sound here
        }
        ifcount 10
        ifcansee ifpdistl 6144
        ifp palive
        {
			    ifrnd 8 
            { 
                ai AIGREYATTACKPLAYER
                sound GREYATTACK
            }
          else
            ifrnd 4
            {
              set targetLoop 0
              state checkGreyRevive
              ifn reviveFound -1
              {
                  ai AIGREYREVIVING 
                  sound GREYATTACK
              }
            }
            else nullop
        }

        ifrnd 4 ifpdistg 6144 ai AIGREYWAIT    
ends

state greyattackstate
  
  ifcount 23
  {
    ifcount 24
      ai AIGREYSEEK
  }
  else
	ifcount 22
  {
    geta[THISACTOR].z greyprojpos
    setvarvar greycurrpos greyprojpos
    subvar greyprojpos 3000
    seta[THISACTOR].z greyprojpos
    shoot GREYPROJECTILE
    seta[THISACTOR].z greycurrpos
  }
   else
	 ifactioncount 6
	   resetactioncount
ends

state greyrevivestate
  
  ifcount 25
  {
    ifcount 27
      ai AIGREYSEEK
  }
  else
	ifcount 24
  {
      //findnearspritez GREYPROJECTILE 5120 20480 temp
      //Need to find a way to look for multiple enemy fallen sprites and have grey face it 
      geta[THISACTOR].z greyprojpos
      setvarvar greycurrpos greyprojpos
      subvar greyprojpos 9000
      seta[THISACTOR].z greyprojpos
      set reviveID reviveFound
      spawn GREYREVIVEPROJECTILE
      seta[THISACTOR].z greycurrpos
      set reviveFound -1
  }
   else
	 ifactioncount 6
	   resetactioncount
ends


state greygrowstate
        state genericgrowcode
        sizeto 255 192
ends

state greyshrunkstate
  ifcount SHRUNKDONECOUNT
    ai AIGREYWAIT
  else
    ifcount SHRUNKCOUNT
      sizeto 48 40
  else
    state genericshrunkcode
ends

state greyfrozenstate

    ifcount THAWTIME
	{
		ai AIGREYWAIT
		getlastpal
    }
    else
		ifcount FROZENDRIPTIME
    {
      ifactioncount 26
      {
        spawn WATERDRIP
        resetactioncount
      }
    }
    ifhitweapon
    {
      ifwasweapon FREEZEBLAST
      {
		strength 0
        break
      }
      addkills 1 

      ifrnd 84
        spawn BLOODPOOL
          lotsofglass 30
      sound GLASS_BREAKING
      killit
    }
    ifp pfacing
      ifpdistl FROZENQUICKKICKDIST
        pkick
  
ends

useractor enemy GREY GREYSTRENGTH

fall
state checksquished
ifai 0
{
	// play alert sound here
    cstat 257
	ai AIGREYSEEK
}

ifai AIGREYDYING
{
    strength 0
       
		ifwasweapon RPG
		{
				sound SQUISHED
				spawn BLOODPOOL
				state standard_jibs
				killit
		}
		ifwasweapon RADIUSEXPLOSION
		{
				sound SQUISHED
				spawn BLOODPOOL
				state standard_jibs
				killit
		}
        
        ifaction GREYDYING
        {
            ifactioncount 5
            {
						cstat 0
						globalsound THUD
                action GREYDEADBODY
                break
            }
        }    
        ifaction GREYDEADBODY
          {
            findnearspritez GREYREVIVEPROJECTILE 200 20000 temp
            ifn temp -1
            {
              addkills -1
              spawn TRANSPORTERSTAR
              cstat 257
              strength GREYSTRENGTH
              ai AIGREYWAIT
              // play sound here
            }
                ifhitweapon
                {
                        ifwasweapon RPG
                        {
                                sound SQUISHED
                                spawn BLOODPOOL
								                state standard_jibs
                                killit
                        }
                        ifwasweapon RADIUSEXPLOSION
                        {
                                sound SQUISHED
                                spawn BLOODPOOL
								                state standard_jibs
                                killit
                        }
                }
                ifcount RESPAWNACTORTIME
                ifrespawn
                {
                  addkills -1
                  spawn TRANSPORTERSTAR
                  cstat 257
                  strength GREYSTRENGTH
                  ai AIGREYWAIT
                  // play sound here
                }
        }
        
        break
}


ifai AIGREYGROW { state greygrowstate break }
ifai AIGREYFROZEN { state greyfrozenstate break }
ifai AIGREYSHRUNK state greyshrunkstate else
ifai AIGREYWAIT state greywaitstate else
ifai AIGREYHIT state greyhitstate else
ifai AIGREYATTACKPLAYER state greyattackstate else
ifai AIGREYREVIVING state greyrevivestate else
ifai AIGREYSEEK state greyseekstate

ifhitweapon
{
    //guts JIBS6 1
    spawn BLOOD

    ifwasweapon SHRINKSPARK
        {
                ifstrength 600
                {
                  sound ACTOR_SHRINKING
                  ai AIGREYSHRUNK
                  // set shrunken 1
                  break
                }
                else addstrength -60
        }
        else
        ifwasweapon GROWSPARK
          sound EXPANDERHIT
		      //guts JIBS2 1
        ifdead
        {
          state enemy_deathtrigger
                ifwasweapon FREEZEBLAST
                {
                  sound SOMETHINGFROZE
                  spritepal 1
                  ai AIGREYFROZEN
                  strength 0
                  // state freezeme
                  break
                }
                ifwasweapon GROWSPARK
                {
                  cstat 0
                  sound ACTOR_GROWING
                  ai AIGREYGROW
                  break
                }
                addkills 1
                sound GREYDEATH
				        // play death sound here
                ai AIGREYDYING
                //guts JIBS6 8
                ifspritepal 0 break
                ifwasweapon RPG
                {
                        sound SQUISHED
                        spawn BLOODPOOL
                        killit
                }
                ifwasweapon RADIUSEXPLOSION
                {
                        sound SQUISHED
                        spawn BLOODPOOL
                        killit
                }
                break
        }
		
        state random_wall_jibs
        // play pain sound here
        ifrnd 2
        spawn BLOODPOOL
		    ifai AIGREYHIT nullop else
          ifai AIGREYSHRUNK nullop else
          {
            ifrnd 16 
            ai AIGREYHIT        
          }
}
enda

eventloadactor GREY
    sizeat 48 40
    state enemy_fxload
    set reviveFound -1
    set targetLoop 0
enda