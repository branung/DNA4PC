useractor notenemy DNA_REDKEY 0
    sizeat 52 44
    state access_shared
enda
useractor notenemy DNA_YELLOWKEY 0
    sizeat 52 44
    state access_shared
enda




//// --------- PREPENDS FOR FREEZING 3D ENEMIES ---------
prependstate troopcode
  geta [].htpicnum temp
  ife temp FREEZEBLAST {
    seta [].htextra -1
    sound SOMETHINGFROZE
    spritepal 1
    seta [].htpicnum LIZTROOP
    move 0
    //resetcount
    action ATROOPFROZEN
  }
ends

prependstate checksquished
  ifactor PIGCOP {
    geta [].htpicnum temp
    ife temp FREEZEBLAST {
      seta [].htextra -1
      sound SOMETHINGFROZE
      spritepal 1
      seta [].htpicnum PIGCOP
      move 0
      //resetcount
      action APIGFROZEN
    }
  }
  ifactor LIZMAN {
    geta [].htpicnum temp
    ife temp FREEZEBLAST {
      seta [].htextra -1
      sound SOMETHINGFROZE
      spritepal 1
      seta [].htpicnum LIZMAN
      move 0
      //resetcount
      action ALIZFROZEN
    }
  }
  ifactor OCTABRAIN {
    geta [].htpicnum temp
    ife temp FREEZEBLAST {
      seta [].htextra -1
      sound SOMETHINGFROZE
      spritepal 1
      seta [].htpicnum OCTABRAIN
      move 0
      //resetcount
      action AOCTAFROZEN
    }
  }
  // Needs to be tested.. also need to add commander
  ifactor NEWBEASTHANG {
    geta [].htpicnum temp
    ife temp FREEZEBLAST {
      seta [].htextra -1
      sound SOMETHINGFROZE
      spritepal 1
      seta [].htpicnum NEWBEASTHANG
      move 0
      //resetcount
      action ANEWBEASTFROZEN
    }
  }
ends

//// --------- EXTRA REVIVE FUNCTION FOR GREY ---------
// This hijacks into the common "checksquished" state from original GAME.CON
// The enemy currently supports reviving trooper/pigcop/octa/newbeast.
appendstate checksquished

    ifaction ATROOPDEAD {
        findnearspritez GREYREVIVEPROJECTILE GREYPROJECTILEREVIVEXY GREYPROJECTILEREVIVEZ temp
        ifn temp -1 {
            addkills -1
            spawn TRANSPORTERSTAR
            cstat 257
            strength TROOPSTRENGTH
            ai AITROOPSEEKENEMY
        }
    }
    ifaction ALIZLYINGDEAD {
        findnearspritez GREYREVIVEPROJECTILE GREYPROJECTILEREVIVEXY GREYPROJECTILEREVIVEZ temp
        ifn temp -1 {
            addkills -1
            spawn TRANSPORTERSTAR
            cstat 257
            strength LIZSTRENGTH
            ai AILIZGETENEMY
        }
    }
    ifaction AOCTADEAD {
        findnearspritez GREYREVIVEPROJECTILE GREYPROJECTILEREVIVEXY GREYPROJECTILEREVIVEZ temp
        ifn temp -1 {
            addkills -1
            spawn TRANSPORTERSTAR
            cstat 257
            strength OCTASTRENGTH
            ai AIOCTAGETENEMY
        }
    }
    ifaction APIGDEAD {
        findnearspritez GREYREVIVEPROJECTILE GREYPROJECTILEREVIVEXY GREYPROJECTILEREVIVEZ temp
        ifn temp -1 {
            addkills -1
            spawn TRANSPORTERSTAR
            cstat 257
            strength PIGCOPSTRENGTH
            ai AIPIGSEEKENEMY
        }
    }
    ifaction ANEWBEASTLYINGDEAD {
        findnearspritez GREYREVIVEPROJECTILE GREYPROJECTILEREVIVEXY GREYPROJECTILEREVIVEZ temp
        ifn temp -1 {
            addkills -1
            spawn TRANSPORTERSTAR
            cstat 257
            strength NEWBEASTSTRENGTH
            ai AINEWBEASTGETENEMY
        }
    }
ends

// Knockback state added here to effect nearly all enemies
prependstate checksquished
    state enemyknockback
ends

// Liztroop gets special treatment
prependstate troopcode
  state enemyknockback
ends

//// --------- EXTRA SCREENFLASH FOR THE PLAYER ---------
// Prepending this state to access hitstate for APLAYER and add custom enemy attack palfroms
prependstate random_wall_jibs
{
    ifactor APLAYER 
    {
        ifhitweapon ifdead nullop 
        else {
        ifwasweapon GREYPROJECTILE
          palfrom 16 0 32 32
        ifwasweapon SLIMECRABPROJECTILE
          palfrom 16 0 64
        ifwasweapon ALIENLORDPROJECTILE
          palfrom 48 32
        ifwasweapon CYBERALIENPBOMB
          palfrom 48 16
        }
    }
}
ends

eventloadactor MBMACHINE
    seta .cstat 32768

enda

move SCVEL 700
action MBMOVE 0 1 1 1 1

ai MBMSCATTER MBMOVE SCVEL randomangle
ai MBMSCATTER2 MBMOVE SCVEL fleeenemy
ai MBMSCATTER3 MBMOVE SCVEL randomangle

useractor notenemy MBMACHINE 0
    ifaction 0 {
        seta .xrepeat 32
        seta .yrepeat 32
        seta .cstat 32768
        ai MBMSCATTER
    }
    ifai MBMSCATTER {
        ifcount 1 ai MBMSCATTER2
    }
    ifai MBMSCATTER2 {
        ifcount 5 {
            ai MBMSCATTER3
        }
    }
    ifai MBMSCATTER3 {
        ifrnd 20 {
            set temp 0
            ife player[myconnectindex].dead_flag 0 {
                ifpdistg 2048 set temp 1
            } else {
                set temp 1
            }
            ife temp 1 {
                switch explosion_snd
                    case 0
                    case 3
                    case 5
                    case 7
                        actorsound THISACTOR A_EXPLOSION
                        break
                endswitch
                add explosion_snd 1
                spawn EXPLOSION2
                killit
            } else killit
        }
    }
enda


// Expects output tag to be in sprite.lotag
defstate activate_lotag
    operateactivators fx_lotag 0
    for u sprofstat STAT_EFFECTOR {
        ife sprite[u].lotag 25 ife sprite[u].hitag fx_lotag {
            geta [u].htg_t 4 temp
            ife temp 1 seta [u].htg_t 4 0 else seta [u].htg_t 4 1
        }
    }
ends

// extra = -1 single use, Positive number is ticks to wait until re-trigger is allowed (+30t recommended)
// owner = set positive to autoclose immediately after extra
// fx_int = auto-forced toggle counter
// fx_int2 = touch toggler allower
// fx_int3 = Extra timer to check that the extra minimum has passed
// temp = use has been requested for this tick
// Linked switches can be done with:
// xvel = Output this when activated once, if extra -1 then will get stuck as "active"
// yvel = Read this, will return to "disabled state" and will be re-usable once more.


defstate switchcode
    switch fx_state
        case disabled
            // If player touches or presses space then approve change
            set temp2 0
            ifpdistg 1024 set fx_int2 0
            ifpdistl 768 ifp pfacing ife fx_int2 0 ife fx_int3 0 set temp2 1
            ifpdistl 1024 ifp pfacing ife fx_int3 0 ifhitspace set temp2 1
            ifn fx_xvel 0 ifl fx_xvel 0 set temp2 0
            ife temp2 1 set fx_state pre_enable
            ifg fx_int3 0 sub fx_int3 1
            ifg fx_yvel 0 ife fx_activate[fx_yvel] 1 set fx_int3 30
            break
        case pre_enable
            ifhitspace {
                nullop
            } else {
                // Visuals & Audio
                sound fx_hitag
                geta .picnum temp2
                add temp2 1
                seta .picnum temp2
                // Activation
                state activate_lotag
                // Setup delays to wait for force-return or imposed wait
                ife fx_extra -1 {
                    set fx_state completed
                } else {
                    ifn fx_owner -1 set fx_int fx_extra else set fx_int 0
                    set fx_int2 fx_extra
                    set fx_int3 fx_extra
                    set fx_state enabled
                }
                ifg fx_xvel 0 {
                    setarray fx_preactivate[fx_xvel] 1
                }
            }
            break
        case enabled
            // Have timers ran out?
            set temp2 0
            ifpdistg 1024 set fx_int2 0
            ifpdistl 512 ifp pfacing ife fx_int2 0 ife fx_int3 0 set temp2 1
            ifn fx_owner -1 {
                ifg fx_int 0 sub fx_int 1
                ife fx_int 0 set temp2 1
            }
            ifpdistl 1024 ifp pfacing ife fx_int 0 ife fx_int3 0 ifhitspace set temp2 1
            ife temp2 1 set fx_state pre_disable
            ifg fx_int3 0 sub fx_int3 1
            break
        case pre_disable
            ifhitspace {
                nullop
            } else {
                sound fx_hitag
                set fx_state disabled
                geta .picnum temp2
                sub temp2 1
                seta .picnum temp2
                state activate_lotag
                set fx_int2 30
                set fx_int3 fx_extra
                set fx_state disabled
            }
            break
        case completed
            // In case yvel gets triggered, re-enable it
            ifg fx_yvel 0 {
                ife fx_activate[fx_yvel] 1 {
                    geta .picnum temp2
                    sub temp2 1
                    seta .picnum temp2
                    set fx_state disabled
                    set fx_int3 30
                }
            }
            break
    endswitch
ends


defstate switchload
    geta .cstat temp
    ifand temp 2 seta .cstat 32768
    geta .owner fx_owner
    geta .extra fx_extra
    seta .owner -1
    seta .extra -1
    set fx_state disabled
    set fx_int2 30
    set fx_int fx_owner
    geta .hitag temp
    ife temp 0 {
        switch sprite[].picnum
        {
          case DNA_SWITCH2A
          case DNA_SWITCH2B
            set fx_hitag A_SWITCH
            break
          case DNA_SWITCH4A
          case DNA_SWITCH4B
            set fx_hitag A_ALIENSWITCH
            break
          default
            set fx_hitag A_ACTIVATE
            break
        }
        endswitch
    } else {
        set fx_hitag temp
    }
    seta .hitag 0
    geta .lotag fx_lotag
    seta .lotag 0
    geta .xvel fx_xvel
    seta .xvel 0
    geta .yvel fx_yvel
    seta .yvel 0
ends

action ACTION_SWOFF 1 1 1 1 1

eventloadactor DNA_SWITCH1A state switchload enda
eventloadactor DNA_SWITCH1B state switchload enda
eventloadactor DNA_SWITCH2A state switchload enda
eventloadactor DNA_SWITCH2B state switchload enda
eventloadactor DNA_SWITCH3A state switchload enda
eventloadactor DNA_SWITCH3B state switchload enda
eventloadactor DNA_SWITCH4A state switchload enda
eventloadactor DNA_SWITCH4B state switchload enda
useractor notenemy DNA_SWITCH1A 0 state switchcode enda
useractor notenemy DNA_SWITCH1B 0 state switchcode enda
useractor notenemy DNA_SWITCH2A 0 state switchcode enda
useractor notenemy DNA_SWITCH2B 0 state switchcode enda
useractor notenemy DNA_SWITCH3A 0 state switchcode enda
useractor notenemy DNA_SWITCH3B 0 state switchcode enda
useractor notenemy DNA_SWITCH4A 0 state switchcode enda
useractor notenemy DNA_SWITCH4B 0 state switchcode enda