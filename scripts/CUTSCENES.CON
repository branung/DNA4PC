                                setvar CUTSCENE_SCREEN OPCUTSCENE10
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        ifvare dna_dukecutscenevoc 2 screensound GM_BACONBITS
                                        else 
                                        {
                                                nullop
                                        }
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 10
                                }
                        }
                        else ifvare CUTSCENE_STEP 10
                        {
                                setvar CUTSCENE_SCREEN OPCUTSCENE11
                                setvar CUTSCENE_DIALOG OPCUTSCENEDIALOG1
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        ifvare dna_dukecutscenevoc 2 screensound GM_TIMEMORE
                                        else 
                                        {
                                                nullop
                                        }
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 11
                                }
                        }
                        else ifvare CUTSCENE_STEP 11
                        {
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                setvar CUTSCENE_SCREEN OPCUTSCENE12
                                setvar CUTSCENE_DIALOG OPCUTSCENEDIALOG2
                                setvar CUTSCENE_DUKE OPCUTSCENEDUKESPRITE
                                ifvarg OP12DUKESLIDEINTIME OPCUTSCENE12DUKEPOS  
                                {
                                                setvar delayTime OP_CUTSCENE_DELAY_TIME
                                                setvar CUTSCENE_SCREEN 5400
                                                setvar CUTSCENE_DIALOG 5400
                                                setvar CUTSCENE_DUKE 5400
                                                setvar OPCUTSCENEPOS OPCUTSCENE12POS
                                                getticks curtick
                                                ifvare prevtick -1 setvar ticktmp 0 else
                                                {
                                                setvarvar ticktmp curtick
                                                subvarvar ticktmp prevtick
                                                }
                                                setvarvar ticktmp2 ticktmp
                                                divvar ticktmp 4
                                                subvarvar OPCUTSCENE12SLIDEINTIME ticktmp
                                                ifvarg OPCUTSCENE12SLIDEINTIME 255 nullop else
                                                {
                                                        divvar ticktmp2 2
                                                        subvarvar OP12DUKESLIDEINTIME ticktmp2
                                                }
                                                
                                                
                                                
                                                
                                                ifvarg OPCUTSCENE12SLIDEINTIME OPCUTSCENE12POS
                                                rotatesprite OPCUTSCENE12SLIDEINTIME 100 81920 0 OPCUTSCENE12 0 0 2 0 0 xdim ydim
                                                else
                                                rotatesprite OPCUTSCENE12POS 100 81920 0 OPCUTSCENE12 0 0 2 0 0 xdim ydim
                                                rotatesprite OP12DUKESLIDEINTIME 120 81920 0 OPCUTSCENEDUKESPRITE 0 0 2 0 0 xdim ydim
                                                rotatesprite 130 180 81920 0 OPCUTSCENEDIALOG2 0 0 2 0 0 xdim ydim
                                                setvarvar prevtick curtick
                                }
                                else   
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        ifvare dna_dukecutscenevoc 2 screensound GM_LETSROCK
                                        else screensound BONUS_SPEECH1 // LET'S ROCK
                                        setvar RETURN 1
                                }
                        }
                        rotatesprite OPCUTSCENEPOS 100 81920 0 CUTSCENE_SCREEN 0 0 2 0 0 xdim ydim
                        rotatesprite OPCUTSCENE12DUKEPOS 120 81920 0 CUTSCENE_DUKE 0 0 2 0 0 xdim ydim
                        rotatesprite 130 180 81920 0 CUTSCENE_DIALOG 0 0 2 0 0 xdim ydim
                }
                ifvare LEVEL 19
                {

                        ifvare CUTSCENE_STEP 0    // FIRST SCREEN
                        {
                                setvar CUTSCENE_DIALOG 5400
                                setvar CUTSCENE_DIALOG2 5400
                                setvar CUTSCENE_SCREEN ENDCUTSCENE1
                                ifvarg SCREENALPHA 0
                                {
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar prevtick -1
                                        setvar SCREENALPHA 0
                                }
                                else
                                ifvarg delayTime 0
                                {
                                        setvar RETURN 0
                                        state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        screensound AAMB_A51SIRENLOOP 
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 1
                                }
                        }
                        else ifvare CUTSCENE_STEP 1   // SECOND SCREEN
                        {
                                
                                setvar CUTSCENE_SCREEN ENDCUTSCENE2
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        //screensound ACTOR_SHRINKING // 
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 2     
                                }
                        }
                        else ifvare CUTSCENE_STEP 2  // THIRD SCREEN
                        {
                                setvar CUTSCENE_SCREEN ENDCUTSCENE3
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        screensound TELEPORTER
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 3     
                                }
                        }
                        else ifvare CUTSCENE_STEP 3
                        {
                                setvar CUTSCENE_DIALOG ENDCUTSCENEDIA1
                                setvar CUTSCENE_SCREEN ENDCUTSCENE4
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        stopallsounds
                                        screensound PIPEBOMB_EXPLODE  
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 4  
                                }
                        }
                        else ifvare CUTSCENE_STEP 4
                        {
                                setvar CUTSCENE_DIALOG 5400
                                setvar CUTSCENE_SCREEN ENDCUTSCENE5
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        screensound TELEPORTER
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 5  
                                }
                        }
                        else ifvare CUTSCENE_STEP 5
                        {
                                setvar CUTSCENE_SCREEN ENDCUTSCENE6
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 6
                                }
                        }
                        else ifvare CUTSCENE_STEP 6
                        {
                                setvar CUTSCENE_DIALOG2 ENDCUTSCENEDIA2
                                setvar CUTSCENE_SCREEN ENDCUTSCENE7
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg ENDDIA1SLIDEINTIME 180
                                {
                                        setvar CUTSCENE_SCREEN 5400
                                        setvar CUTSCENE_DIALOG 5400
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar RETURN 0
                                        getticks curtick
                                        ifvare prevtick -1 setvar ticktmp 0 else
                                        {
                                                setvarvar ticktmp curtick
                                                subvarvar ticktmp prevtick
                                        }

                                        divvar ticktmp 4
                                        subvarvar ENDDIA1SLIDEINTIME ticktmp

                                        rotatesprite 160 100 81920 0 ENDCUTSCENE7 0 0 2 0 0 xdim ydim
                                        rotatesprite ENDCUTSCENEDIAPOSX1 ENDDIA1SLIDEINTIME 81920 0 ENDCUTSCENEDIA3 0 0 2 0 0 xdim ydim
                                        rotatesprite ENDCUTSCENEDIAPOSX2 ENDCUTSCENEDIAPOSY2 81920 0 CUTSCENE_DIALOG2 0 0 2 0 0 xdim ydim

                                        setvarvar prevtick curtick
                                }
                                else
                                {
                                        setvar CUTSCENE_SCREEN ENDCUTSCENE7
                                        setvar CUTSCENE_DIALOG ENDCUTSCENEDIA3
                                }
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        setvar CUTSCENE_DIALOG 5400
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 7
                                }
                        }
                        else ifvare CUTSCENE_STEP 7
                        {
                                
                                setvar CUTSCENE_DIALOG2 5400
                                setvar CUTSCENE_SCREEN ENDCUTSCENE8
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg ENDDIA2SLIDEINTIME 180
                                {
                                        setvar CUTSCENE_SCREEN 5400
                                        setvar CUTSCENE_DIALOG 5400
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar RETURN 0
                                        getticks curtick
                                        ifvare prevtick -1 setvar ticktmp 0 else
                                        {
                                                setvarvar ticktmp curtick
                                                subvarvar ticktmp prevtick
                                        }

                                        divvar ticktmp 4
                                        subvarvar ENDDIA2SLIDEINTIME ticktmp

                                        rotatesprite 160 100 81920 0 ENDCUTSCENE8 0 0 2 0 0 xdim ydim
                                        rotatesprite ENDCUTSCENEDIAPOSX1 ENDDIA2SLIDEINTIME 81920 0 ENDCUTSCENEDIA4 0 0 2 0 0 xdim ydim
                                        rotatesprite ENDCUTSCENEDIAPOSX2 ENDCUTSCENEDIAPOSY2 81920 0 CUTSCENE_DIALOG2 0 0 2 0 0 xdim ydim

                                        setvarvar prevtick curtick
                                }
                                else
                                {
                                        setvar CUTSCENE_SCREEN ENDCUTSCENE8
                                        setvar CUTSCENE_DIALOG ENDCUTSCENEDIA4
                                }
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        setvar CUTSCENE_DIALOG 5400
                                        ifvare dna_dukecutscenevoc 2 screensound GM_HAILTOKING
                                        else screensound DUKE_GETWEAPON6 // HAIL TO THE KING
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 8
                                }
                        }
                        else ifvare CUTSCENE_STEP 8
                        {
                                setvar CUTSCENE_SCREEN ENDCUTSCENE9
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg ENDDIA3SLIDEINTIME 180
                                {
                                        setvar CUTSCENE_SCREEN 5400
                                        setvar CUTSCENE_DIALOG 5400
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar RETURN 0
                                        getticks curtick
                                        ifvare prevtick -1 setvar ticktmp 0 else
                                        {
                                                setvarvar ticktmp curtick
                                                subvarvar ticktmp prevtick
                                        }

                                        divvar ticktmp 4
                                        subvarvar ENDDIA3SLIDEINTIME ticktmp

                                        rotatesprite 160 100 81920 0 ENDCUTSCENE9 0 0 2 0 0 xdim ydim
                                        rotatesprite ENDCUTSCENEDIAPOSX1 ENDDIA3SLIDEINTIME 81920 0 ENDCUTSCENEDIA5 0 0 2 0 0 xdim ydim
                                        rotatesprite ENDCUTSCENEDIAPOSX2 ENDCUTSCENEDIAPOSY2 81920 0 CUTSCENE_DIALOG2 0 0 2 0 0 xdim ydim

                                        setvarvar prevtick curtick
                                }
                                else
                                {
                                        setvar CUTSCENE_SCREEN ENDCUTSCENE9
                                        setvar CUTSCENE_DIALOG ENDCUTSCENEDIA5
                                }
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar RETURN 1
                                }
                        }

                        rotatesprite 160 100 81920 0 CUTSCENE_SCREEN 0 0 2 0 0 xdim ydim
                        rotatesprite ENDCUTSCENEDIAPOSX1 ENDCUTSCENEDIAPOSY1 81920 0 CUTSCENE_DIALOG 0 0 2 0 0 xdim ydim
                        rotatesprite ENDCUTSCENEDIAPOSX2 ENDCUTSCENEDIAPOSY2 81920 0 CUTSCENE_DIALOG2 0 0 2 0 0 xdim ydim
                }


        }

        
    }
endevent