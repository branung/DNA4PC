defstate cutscene_killswitch_check
{
        for i range 4 {
                set curr_quote textQuoteRow1
                add curr_quote i
                qstrlen cutscene_length curr_quote
                ifge cutscene_length 3 {
                        set cutscene_killswitch_start cutscene_length
                        sub cutscene_killswitch_start 3
                        qsubstr cutscene_quote_check curr_quote cutscene_killswitch_start 3
                        qstrcmp cutscene_quote_check KILLSWITCH_LINE temp
                        ife temp 0 {
                                set kill_cutscene 1 
                                ife cutscene_killswitch_start 0 {
                                        qstrcpy newTextQuote 200
                                } else {
                                        qsubstr newTextQuote curr_quote 0 cutscene_killswitch_start
                                }
                        qstrcpy curr_quote newTextQuote
                        }
                        
                }
                add i 1
        }
        
}
ends

defstate cutscene_loop 
{
        whilen kill_cutscene 1
        {
                state get_cutscene_details
                ife dont_stop_sounds 1 set dont_stop_sounds 0
                else stopallsounds
                startscreen
        }
}
ends

appendevent EVENT_GAME
    ifvarn in_cutscene 0
    {
        ifvarn cutscene_num 0
        {
        state get_script // Gets the correct localization of the dialog in DIALOGDEF.CON
        state cutscene_cleanup
        ifvare dna_cutscenes 1 { state end_cutscene } // If level cutscenes are disabled, immediately stop cutscene from processing
        else ifvare dna_cutscenes 0 
        {
                setvar delayTime 500 // Inital delay on cutscene start
                state cutscene_loop                                  
                state end_cutscene
        }
        }
    }
endevent

defstate setup_cutscene_panel {
        ife skip_this_panel 0 { state waste_time } // If panel isn't skipped, dont allow input immediately
        ife CUTSCENE_STEP 0 {
                set curr_cutscene CUTSCENE_STEP
                set textQuoteRow2 textQuoteRow1
                set textQuoteRow3 textQuoteRow1
                set textQuoteRow4 textQuoteRow1
                add textQuoteRow2 1
                add textQuoteRow3 2
                add textQuoteRow4 3
                
        }
        else {
                ifl curr_cutscene CUTSCENE_STEP
                {
                        add textQuoteRow1 4
                        add textQuoteRow2 4
                        add textQuoteRow3 4
                        add textQuoteRow4 4
                        set curr_cutscene CUTSCENE_STEP
                }
        }
        state cutscene_killswitch_check
        ife skip_this_panel 1 { 
                set RETURN 1 set skip_this_panel 0 } // If panel is skipped - due to localization - set return after text quote has been calulated so its accurate next panel
        ife RETURN 1     // IF THE PLAYER USES ANY KEY TO SKIP THE SCENE
        {
                setvar delayTime CUTSCENE_DELAY_TIME  // DELAY TIME BEFORE USER INPUT WILL BE REGISTERED
                add CUTSCENE_STEP 1     // CHANGE TO THE NEXT SCREEN
        }
}
ends

defstate display_cutscene_dialogue
{
        setvar y 176
        set x 55
        rotatesprite 160 201 65536 0 CUTSCENE_DIALOGBOX 0 0 8 0 0 xdim ydim
        rotatesprite 31 196 65536 0 CUTSCENE_SPRITE 0 0 8 0 0 xdim ydim
        rotatesprite 160 201 65536 0 CUTSCENE_OUTLINE 0 0 8 0 0 xdim ydim
        screentext STARTALPHANUM x y 65536 0 0 textQuoteRow1 0 0 16 0 8 0 0 0 0 0 0 xdim ydim
        addvar y 10
        screentext STARTALPHANUM x y 65536 0 0 textQuoteRow2 0 0 16 0 8 0 0 0 0 0 0 xdim ydim
        addvar y 10
        screentext STARTALPHANUM x y 65536 0 0 textQuoteRow3 0 0 16 0 8 0 0 0 0 0 0 xdim ydim
        addvar y 10
        screentext STARTALPHANUM x y 65536 0 0 textQuoteRow4 0 0 16 0 8 0 0 0 0 0 0 xdim ydim
}
ends

appendevent EVENT_SCREEN
        state setsqraspect
    ifvarn in_cutscene 0
    {
        ifvarn cutscene_num 0
        {
                ifvarg SCREENALPHA 0 { state screen_fadeout }

        ifvare VOLUME 0
        {
                setvar SCREENALPHAWORLD 255
                setvar worldprevtick -1 // Keep resetting world fade values while in cutscene so the fade returns once exiting
        }
                state setup_cutscene_panel // Set up text
                state cutcam_render // Set up the cutscene's visual
                state display_cutscene_dialogue // And now display everything
        }
    }
    else
    {
        ife in_endlevel_screen 0 { // As name says: checks if we're not in end level screen
        ifvare VOLUME 0
        {
                ifvare LEVEL 0 // AKA Level 1 - Gathering Intel
                {
                        ife in_opening_cutscene 1
                        { 
                        ifvare CUTSCENE_STEP 0    // FIRST SCREEN
                        {
                                setvar OPCUTSCENEPOS 160
                                ifvarg OPCUTSCENESLIDEINTIME 160  
                                {
                                                setvar delayTime OP_CUTSCENE_DELAY_TIME
                                                setvar CUTSCENE_SCREEN 5400
                                                setvar CUTSCENE_DIALOG 5400
                                                setvar CUTSCENE_DUKE 5400
                                                setvar RETURN 0
                                                getticks curtick
                                                ifvare prevtick -1 setvar ticktmp 0 else
                                                {
                                                setvarvar ticktmp curtick
                                                subvarvar ticktmp prevtick
                                                }

                                                divvar ticktmp 2
                                                subvarvar OPCUTSCENESLIDEINTIME ticktmp
                                                
                                                rotatesprite OPCUTSCENESLIDEINTIME 100 CUTSCENE_SIZE 0 OPCUTSCENE1 0 0 72 0 0 xdim ydim
                                                setvarvar prevtick curtick
                                }
                                else
                                setvar CUTSCENE_SCREEN OPCUTSCENE1
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        ifvare dna_dukecutscenevoc 2 screensound GM_WHOWANTSSOME
                                        else screensound DUKE_GETWEAPON4 // WHO WANTS SOME
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 1     // CHANGE TO THE NEXT SCREEN
                                }
                        }
                        else ifvare CUTSCENE_STEP 1   // SECOND SCREEN
                        {
                                
                                setvar CUTSCENE_SCREEN OPCUTSCENE2
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        screensound A_SHRINK // SHRINKER FIRE
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 2     
                                }
                        }
                        else ifvare CUTSCENE_STEP 2  // THIRD SCREEN
                        {
                                setvar CUTSCENE_SCREEN OPCUTSCENE3
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        screensound PIG_DYING // PIG SQUEAL
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 3     
                                }
                        }
                        else ifvare CUTSCENE_STEP 3
                        {
                                setvar CUTSCENE_SCREEN OPCUTSCENE4
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        ifvare dna_dukecutscenevoc 2 screensound GM_COOL
                                        else screensound DUKE_GETWEAPON1 // COOL
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 4  
                                }
                        }
                        else ifvare CUTSCENE_STEP 4
                        {
                                setvar CUTSCENE_SCREEN OPCUTSCENE5
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 5  
                                }
                        }
                        else ifvare CUTSCENE_STEP 5
                        {
                                setvar CUTSCENE_SCREEN OPCUTSCENE6
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        ifvare dna_dukecutscenevoc 2 screensound GM_HAILTOKING
                                        else screensound DUKE_GETWEAPON6 // HAIL TO THE KING
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 6
                                }
                        }
                        else ifvare CUTSCENE_STEP 6
                        {
                                setvar CUTSCENE_SCREEN OPCUTSCENE7
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        screensound PIG_DYING // PIG SQUEAL
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 7
                                }
                        }
                        else ifvare CUTSCENE_STEP 7
                        {
                                setvar CUTSCENE_SCREEN OPCUTSCENE8
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        screensound SQUISHED // ...SQUISH
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 8
                                }
                        }
                        else ifvare CUTSCENE_STEP 8
                        {
                                setvar CUTSCENE_SCREEN OPCUTSCENE9
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        ifvare dna_dukecutscenevoc 2 screensound GM_THATSGOTTAHURT
                                        else screensound JIBBED_ACTOR7 // THAT'S GOTTA HURT
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 9
                                }
                        }
                        else ifvare CUTSCENE_STEP 9
                        {
                                setvar CUTSCENE_SCREEN OPCUTSCENE10
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        ifvare dna_dukecutscenevoc 2 screensound GM_BACONBITS
                                        else 
                                        {
                                                nullop
                                        }
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 10
                                }
                        }
                        else ifvare CUTSCENE_STEP 10
                        {
                                setvar CUTSCENE_SCREEN OPCUTSCENE11
                                setvar CUTSCENE_DIALOG OPCUTSCENEDIALOG1
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        ifvare dna_dukecutscenevoc 2 screensound GM_TIMEMORE
                                        else 
                                        {
                                                nullop
                                        }
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 11
                                }
                        }
                        else ifvare CUTSCENE_STEP 11
                        {
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                setvar CUTSCENE_SCREEN OPCUTSCENE12
                                setvar CUTSCENE_DIALOG OPCUTSCENEDIALOG2
                                setvar CUTSCENE_DUKE OPCUTSCENEDUKESPRITE
                                ifvarg OP12DUKESLIDEINTIME OPCUTSCENE12DUKEPOS  
                                {
                                                setvar delayTime OP_CUTSCENE_DELAY_TIME
                                                setvar CUTSCENE_SCREEN 5400
                                                setvar CUTSCENE_DIALOG 5400
                                                setvar CUTSCENE_DUKE 5400
                                                setvar OPCUTSCENEPOS OPCUTSCENE12POS
                                                getticks curtick
                                                ifvare prevtick -1 setvar ticktmp 0 else
                                                {
                                                setvarvar ticktmp curtick
                                                subvarvar ticktmp prevtick
                                                }
                                                setvarvar ticktmp2 ticktmp
                                                divvar ticktmp 4
                                                subvarvar OPCUTSCENE12SLIDEINTIME ticktmp
                                                ifvarg OPCUTSCENE12SLIDEINTIME 255 nullop else
                                                {
                                                        divvar ticktmp2 2
                                                        subvarvar OP12DUKESLIDEINTIME ticktmp2
                                                }
                                                
                                                
                                                
                                                
                                                ifvarg OPCUTSCENE12SLIDEINTIME OPCUTSCENE12POS
                                                rotatesprite OPCUTSCENE12SLIDEINTIME 100 CUTSCENE_SIZE 0 OPCUTSCENE12 0 0 72 0 0 xdim ydim
                                                else
                                                rotatesprite OPCUTSCENE12POS 100 CUTSCENE_SIZE 0 OPCUTSCENE12 0 0 72 0 0 xdim ydim
                                                rotatesprite OP12DUKESLIDEINTIME 120 81920 0 OPCUTSCENEDUKESPRITE 0 0 2 0 0 xdim ydim
                                                rotatesprite 130 180 81920 0 OPCUTSCENEDIALOG2 0 0 2 0 0 xdim ydim
                                                setvarvar prevtick curtick
                                }
                                else   
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        ifvare dna_dukecutscenevoc 2 screensound GM_LETSROCK
                                        else screensound BONUS_SPEECH1 // LET'S ROCK
                                        setvar SCREENALPHA 255
                                        setvar RETURN 1
                                }
                        }
                        rotatesprite OPCUTSCENEPOS 100 CUTSCENE_SIZE 0 CUTSCENE_SCREEN 0 0 72 0 0 xdim ydim
                        rotatesprite OPCUTSCENE12DUKEPOS 120 CUTSCENE_SIZE 0 CUTSCENE_DUKE 0 0 72 0 0 xdim ydim
                        rotatesprite 130 180 81920 0 CUTSCENE_DIALOG 0 0 8 0 0 xdim ydim
                        }
                }
                ifvare LEVEL 19
                {
                        ife in_ending_cutscene 1 { 
                        ifvare CUTSCENE_STEP 0    // FIRST SCREEN
                        {
                                setvar CUTSCENE_DIALOG 5400
                                setvar CUTSCENE_DIALOG2 5400
                                setvar CUTSCENE_SCREEN ENDCUTSCENE1
                                ifvarg SCREENALPHA 0
                                {
                                        state screen_fadeout
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                }
                                else
                                ifvarg delayTime 0
                                {
                                        setvar RETURN 0
                                        state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        screensound A51SIRENLOOP_CUTSCENE 
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 1
                                }
                        }
                        else ifvare CUTSCENE_STEP 1   // SECOND SCREEN
                        {
                                
                                setvar CUTSCENE_SCREEN ENDCUTSCENE2
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        //screensound ACTOR_SHRINKING // 
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 2     
                                }
                        }
                        else ifvare CUTSCENE_STEP 2  // THIRD SCREEN
                        {
                                setvar CUTSCENE_SCREEN ENDCUTSCENE3
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        screensound TELEPORTER
                                        ifvare dna_dukecutscenevoc 2 { 
                                                screensound GM_HAVEABLAST
                                                setvar delayTime 3100
                                        }
                                        else {
                                                setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        }
                                        setvar CUTSCENE_STEP 3     
                                }
                        }
                        else ifvare CUTSCENE_STEP 3
                        {
                                setvar CUTSCENE_DIALOG ENDCUTSCENEDIA1
                                setvar CUTSCENE_SCREEN ENDCUTSCENE4
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        stopallsounds
                                        screensound PIPEBOMB_EXPLODE  
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 4  
                                }
                        }
                        else ifvare CUTSCENE_STEP 4
                        {
                                setvar CUTSCENE_DIALOG 5400
                                setvar CUTSCENE_SCREEN ENDCUTSCENE5
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        screensound TELEPORTER
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 5  
                                }
                        }
                        else ifvare CUTSCENE_STEP 5
                        {
                                setvar CUTSCENE_SCREEN ENDCUTSCENE6
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 6
                                }
                        }
                        else ifvare CUTSCENE_STEP 6
                        {
                                setvar CUTSCENE_DIALOG2 ENDCUTSCENEDIA2
                                setvar CUTSCENE_SCREEN ENDCUTSCENE7
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg ENDDIA1SLIDEINTIME 180
                                {
                                        setvar CUTSCENE_SCREEN 5400
                                        setvar CUTSCENE_DIALOG 5400
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar RETURN 0
                                        getticks curtick
                                        ifvare prevtick -1 setvar ticktmp 0 else
                                        {
                                                setvarvar ticktmp curtick
                                                subvarvar ticktmp prevtick
                                        }

                                        divvar ticktmp 4
                                        subvarvar ENDDIA1SLIDEINTIME ticktmp

                                        rotatesprite 160 100 CUTSCENE_SIZE 0 ENDCUTSCENE7 0 0 72 0 0 xdim ydim
                                        rotatesprite ENDCUTSCENEDIAPOSX1 ENDDIA1SLIDEINTIME CUTSCENE_SIZE 0 ENDCUTSCENEDIA3 0 0 72 0 0 xdim ydim
                                        rotatesprite ENDCUTSCENEDIAPOSX2 ENDCUTSCENEDIAPOSY2 81920 0 CUTSCENE_DIALOG2 0 0 2 0 0 xdim ydim

                                        setvarvar prevtick curtick
                                }
                                else
                                {
                                        setvar CUTSCENE_SCREEN ENDCUTSCENE7
                                        setvar CUTSCENE_DIALOG ENDCUTSCENEDIA3
                                }
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        setvar CUTSCENE_DIALOG 5400
                                        ifvare dna_dukecutscenevoc 2 screensound GM_DEBRIEFING
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 7
                                }
                        }
                        else ifvare CUTSCENE_STEP 7
                        {
                                
                                setvar CUTSCENE_DIALOG2 5400
                                setvar CUTSCENE_SCREEN ENDCUTSCENE8
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg ENDDIA2SLIDEINTIME 180
                                {
                                        setvar CUTSCENE_SCREEN 5400
                                        setvar CUTSCENE_DIALOG 5400
                                        ifvare dna_dukecutscenevoc 2 { setvar delayTime 5000 } else { setvar delayTime OP_CUTSCENE_DELAY_TIME }
                                        setvar RETURN 0
                                        getticks curtick
                                        ifvare prevtick -1 setvar ticktmp 0 else
                                        {
                                                setvarvar ticktmp curtick
                                                subvarvar ticktmp prevtick
                                        }

                                        divvar ticktmp 4
                                        subvarvar ENDDIA2SLIDEINTIME ticktmp

                                        rotatesprite 160 100 CUTSCENE_SIZE 0 ENDCUTSCENE8 0 0 72 0 0 xdim ydim
                                        rotatesprite ENDCUTSCENEDIAPOSX1 ENDDIA2SLIDEINTIME CUTSCENE_SIZE 0 ENDCUTSCENEDIA4 0 0 72 0 0 xdim ydim
                                        rotatesprite ENDCUTSCENEDIAPOSX2 ENDCUTSCENEDIAPOSY2 81920 0 CUTSCENE_DIALOG2 0 0 2 0 0 xdim ydim

                                        setvarvar prevtick curtick
                                }
                                else
                                {
                                        setvar CUTSCENE_SCREEN ENDCUTSCENE8
                                        setvar CUTSCENE_DIALOG ENDCUTSCENEDIA4
                                }
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar SCREENALPHA 255
                                        setvar CUTSCENE_DIALOG 5400
                                        ifvare dna_dukecutscenevoc 2 screensound GM_HAILTOKING
                                        else screensound DUKE_GETWEAPON6 // HAIL TO THE KING
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar CUTSCENE_STEP 8
                                }
                        }
                        else ifvare CUTSCENE_STEP 8
                        {
                                setvar CUTSCENE_SCREEN ENDCUTSCENE9
                                ifvarg SCREENALPHA 0
                                        state screen_fadeout
                                else
                                ifvarg ENDDIA3SLIDEINTIME 180
                                {
                                        setvar CUTSCENE_SCREEN 5400
                                        setvar CUTSCENE_DIALOG 5400
                                        setvar delayTime OP_CUTSCENE_DELAY_TIME
                                        setvar RETURN 0
                                        getticks curtick
                                        ifvare prevtick -1 setvar ticktmp 0 else
                                        {
                                                setvarvar ticktmp curtick
                                                subvarvar ticktmp prevtick
                                        }

                                        divvar ticktmp 4
                                        subvarvar ENDDIA3SLIDEINTIME ticktmp

                                        rotatesprite 160 100 CUTSCENE_SIZE 0 ENDCUTSCENE9 0 0 72 0 0 xdim ydim
                                        rotatesprite ENDCUTSCENEDIAPOSX1 ENDDIA3SLIDEINTIME 81920 0 ENDCUTSCENEDIA5 0 0 72 0 0 xdim ydim
                                        rotatesprite ENDCUTSCENEDIAPOSX2 ENDCUTSCENEDIAPOSY2 81920 0 CUTSCENE_DIALOG2 0 0 2 0 0 xdim ydim

                                        setvarvar prevtick curtick
                                }
                                else
                                {
                                        setvar CUTSCENE_SCREEN ENDCUTSCENE9
                                        setvar CUTSCENE_DIALOG ENDCUTSCENEDIA5
                                }
                                ifvarg delayTime 0
                                {
                                       state cutscene_timer
                                }
                                else
                                {
                                        setvar RETURN 1
                                }
                        }

                        rotatesprite 160 100 CUTSCENE_SIZE 0 CUTSCENE_SCREEN 0 0 72 0 0 xdim ydim
                        rotatesprite ENDCUTSCENEDIAPOSX1 ENDCUTSCENEDIAPOSY1 81920 0 CUTSCENE_DIALOG 0 0 2 0 0 xdim ydim
                        rotatesprite ENDCUTSCENEDIAPOSX2 ENDCUTSCENEDIAPOSY2 81920 0 CUTSCENE_DIALOG2 0 0 2 0 0 xdim ydim
                        }

                
                ife in_credits 1 { // Credits screens
                        state show_credits
                        ifvarg SCREENALPHA 0
                        {
                                state screen_fadeout
                        }
                        ifvare RETURN 1
                        {
                                setvar prevtick -1
                                setvar SCREENALPHA 0
                                setvar in_credits 2
                        }  
                        }
                        else ife in_credits 2
                        {
                        state show_credits
                        ifvarl SCREENALPHA 255
                        {
                                state screen_fadein
                        }
                        else {
                                setvar prevtick -1
                                setvar SCREENALPHA 255
                                setvar in_credits 0
                                setvar RETURN 1
                        }
                }
                
                        
                }

        ife in_objective_screen 1 { // Objective level screens
                state display_objective_screen
                ifvarg SCREENALPHA 0
                {
                        state screen_fadeout
                }
                ifvare RETURN 1
                {
                        setvar prevtick -1
                        setvar SCREENALPHA 0
                        setvar in_objective_screen 2
                }  
        }
        else ife in_objective_screen 2
        {
                state display_objective_screen
                ifvarl SCREENALPHA 255
                {
                        state screen_fadein
                }
                else {
                        setvar prevtick -1
                        setvar SCREENALPHA 255
                        setvar in_objective_screen 0
                        setvar RETURN 1
                }
        }

        }
        }
        else ife in_endlevel_screen 1 { // End level screens
                state display_end_screen
                ifvarg SCREENALPHA 0
                {
                        state screen_fadeout
                }
                ifvare RETURN 1
                {
                        setvar prevtick -1
                        globalsound A_PISTOL
                        setvar SCREENALPHA 0
                        setvar in_endlevel_screen 2
                }  
        }
        else ife in_endlevel_screen 2
        {
                state display_end_screen
                ifvarl SCREENALPHA 255
                {
                        state screen_fadein
                }
                else {
                        setvar prevtick -1
                        setvar SCREENALPHA 255
                        setvar in_endlevel_screen 0
                        setvar RETURN 1
                }
        }
        
    }
    state setdosaspect
endevent