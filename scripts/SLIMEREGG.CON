actor SLIMECRABPROJECTILE SLIMEREGGPROJECTILESTRENGTH enda

spriteflags SLIMEREGG 4194304

action SLIMEREGGWAIT 0
action SLIMEREGGHATCH 2
action SLIMEREGGATTACKING        2  2  1  1  30
action SLIMEREGGDYING            11  5  1  1  8
action SLIMEREGGDEADBODY         16  1  1  1  10
action SLIMEREGGFROZEN           0   1  0  1  10
action SLIMEREGGFLINCH           5  1  5  1  10
action SLIMEREGGGROW             0   1  1  1  10

move SLIMEREGGSTOPPED
move SLIMEREGGSHRUNKVELS 32

gamevar slimereggprojpos 0 0
gamevar slimereggcurrpos 0 0

ai AISLIMEREGGWAIT                     SLIMEREGGWAIT SLIMEREGGSTOPPED geth
ai AISLIMEREGGATTACKPLAYER                SLIMEREGGATTACKING SLIMEREGGSTOPPED faceplayer
ai AISLIMEREGGDYING	            SLIMEREGGDYING SLIMEREGGSTOPPED geth
ai AISLIMEREGGHIT                SLIMEREGGFLINCH SLIMEREGGSTOPPED faceplayer
ai AISLIMEREGGFROZEN             SLIMEREGGFROZEN SLIMEREGGSTOPPED geth
ai AISLIMEREGGSHRUNK             SLIMEREGGWAIT SLIMEREGGSTOPPED geth
ai AISLIMEREGGGROW               SLIMEREGGGROW SLIMEREGGSTOPPED geth

state slimeregghitstate
  ifcount 9 ai AISLIMEREGGWAIT
ends

state slimereggwaitstate
	ifcansee ifpdistl 6144
  ifrnd 2
  {
    // add sound here
  }
  ifcount 10
  ifcansee ifpdistl 6144
  ifp palive
  {
    ifrnd 12 
    { 
      ai AISLIMEREGGATTACKPLAYER 
      sound SLIMERATTACK
    }
  }

  ifrnd 4 ifpdistg 6144 ai AISLIMEREGGWAIT    
ends

state slimereggattackstate
  ifcount 12
  {
    ifcount 14
      ai AISLIMEREGGWAIT
  }
  else
	ifcount 11
  {
    geta[THISACTOR].z slimereggprojpos
    setvarvar slimereggcurrpos slimereggprojpos
    subvar slimereggprojpos 3000
    seta[THISACTOR].z slimereggprojpos      
    shoot SLIMECRABPROJECTILE
    seta[THISACTOR].z slimereggcurrpos
  }
   else
	 ifactioncount 2
	   resetactioncount
ends

state slimeregggrowstate
  state genericgrowcode
  sizeto 255 192
ends

state slimereggshrunkstate
  ifcount SHRUNKDONECOUNT
    ai AISLIMEREGGWAIT
  else
    ifcount SHRUNKCOUNT
        {
          ifspritepal 0 { sizeto 72 64 sizeto 72 64 }
          else
      sizeto 48 40
        }
  else
    state genericshrunkcode
ends

state slimereggfrozenstate
  ifcount THAWTIME
	{
		ai AISLIMEREGGWAIT
		getlastpal
    }
    else
		ifcount FROZENDRIPTIME
    {
      ifactioncount 26
      {
        spawn WATERDRIP
        resetactioncount
      }
    }
    ifhitweapon
    {
      ifwasweapon FREEZEBLAST
      {
		strength 0
        break
      }
      addkills 1 
          // state enemy_death

      ifrnd 84
        spawn BLOODPOOL
          lotsofglass 30
      sound GLASS_BREAKING
      killit
    }
    ifp pfacing
      ifpdistl FROZENQUICKKICKDIST
        pkick
  
ends

useractor enemy SLIMEREGG SLIMEREGGSTRENGTH

  fall
  state checksquished
  ifai 0
  {
    action SLIMEREGGHATCH
    sound EGGHATCH
    // play alert sound here
    cstat 257
    ai AISLIMEREGGWAIT
    break
  }

  ifai AISLIMEREGGDYING
  {
    strength 0
		ifwasweapon RPG
		{
      sound SQUISHED
      spawn BLOODPOOL
      state standard_jibs
      killit
		}
		ifwasweapon RADIUSEXPLOSION
		{
      sound SQUISHED
      spawn BLOODPOOL
      state standard_jibs
      killit
		}
    ifaction SLIMEREGGDYING
    {
      ifactioncount 5
      {
        cstat 0
        globalsound THUD
        action SLIMEREGGDEADBODY
        break
      }
    }    
    ifaction SLIMEREGGDEADBODY
    {
      findnearspritez GREYREVIVEPROJECTILE GREYPROJECTILEREVIVEXY GREYPROJECTILEREVIVEZ temp
      ifn temp -1
      {
        addkills -1
        spawn TRANSPORTERSTAR
        cstat 257
        strength SLIMEREGGSTRENGTH
        ai AISLIMEREGGWAIT
        // play sound here
      }
      ifhitweapon
      {
        ifwasweapon RPG
        {
          sound SQUISHED
          spawn BLOODPOOL
          state standard_jibs
          killit
          }
          ifwasweapon RADIUSEXPLOSION
          {
            sound SQUISHED
            spawn BLOODPOOL
            state standard_jibs
            killit
          }
      }
      ifcount RESPAWNACTORTIME
      ifrespawn
      {
        addkills -1
        spawn TRANSPORTERSTAR
        cstat 257
        strength SLIMEREGGSTRENGTH
        ai AISLIMEREGGWAIT
        // play sound here
      }
  }
    break
  }

ifai AISLIMEREGGGROW { state slimeregggrowstate break }
ifai AISLIMEREGGFROZEN { state slimereggfrozenstate break }
ifai AISLIMEREGGSHRUNK state slimereggshrunkstate else
ifai AISLIMEREGGWAIT state slimereggwaitstate else
ifai AISLIMEREGGHIT state slimeregghitstate else
ifai AISLIMEREGGATTACKPLAYER state slimereggattackstate


 geta [].htpicnum temp
 ife temp FREEZEBLAST {
  seta [].htextra -1
  sound SOMETHINGFROZE
  spritepal 1
  seta [].htpicnum SLIMEREGG
  //resetcount
  ai AISLIMEREGGFROZEN
 }

ifhitweapon
{
  spawn BLOOD
  ifwasweapon SHRINKSPARK
  {
    ifstrength 600
    {
      sound ACTOR_SHRINKING
      ai AISLIMEREGGSHRUNK
      // set shrunken 1
      break
    }
    else addstrength -60
  }
  else
  ifwasweapon GROWSPARK
    sound EXPANDERHIT
  //guts JIBS2 1
  ifdead
  {
    // ifwasweapon FREEZEBLAST
    // {
    //   sound SOMETHINGFROZE
    //   spritepal 1
    //   ai AISLIMEREGGFROZEN
    //   strength 0
    //   // state freezeme
    //   break
    // }
    ifwasweapon GROWSPARK
    {
      cstat 0
      sound ACTOR_GROWING
      ai AISLIMEREGGGROW
      break
    }
    addkills 1
    sound SLIM_DYING
    ai AISLIMEREGGDYING
    //guts JIBS6 8
    ifspritepal 0 break
    ifwasweapon RPG
    {
      sound SQUISHED
      spawn BLOODPOOL
      killit
    }
    ifwasweapon RADIUSEXPLOSION
    {
      sound SQUISHED
      spawn BLOODPOOL
      killit
    }
    break
  }
  
  state random_wall_jibs
  // play pain sound here
  ifrnd 2
    spawn BLOODPOOL
  ifai AISLIMEREGGHIT nullop else
  ifai AISLIMEREGGSHRUNK nullop else
  {
    ifrnd 16 
      ai AISLIMEREGGHIT        
  }

}
enda

eventloadactor SLIMEREGG
  sizeat 48 40
enda