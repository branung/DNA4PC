define TERMINAL1 3683
define TERMINAL2 3684
define TERMINAL3 3685
define TERMINAL4 3686
define TERMINALBROKE 3687
define HYBRIDCAPSULE 3648
define HYBRIDCAPSULEBROKE 3649
define THINMONITOR 3617
define THINMONITORBROKE 3619
define WIDEMONITOR 3627
define WIDEMONITORBROKE 3630
define WIDEMONITORDUALSCREEN 3631
define WIDEMONITORDUALSCREENBROKE 3634
define SMALLMONITOR1 3673
define SMALLMONITOR2 3689
define SMALLMONITOR3 3690
define SMALLMONITOR4 3691
define SMALLMONITORBROKE 3692
define LONGMONITOR1 3693
define LONGMONITOR2 3694
define LONGMONITOR3 3695
define LONGMONITORBROKE 3696

