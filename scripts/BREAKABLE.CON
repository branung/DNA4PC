damageeventtilerange TERMINAL1 TERMINALBROKE
damageeventtilerange TERMINAL2 TERMINALBROKE
damageeventtilerange TERMINAL3 TERMINALBROKE
damageeventtilerange TERMINAL4 TERMINALBROKE
damageeventtilerange HYBRIDCAPSULE HYBRIDCAPSULEBROKE 
damageeventtilerange THINMONITOR THINMONITORBROKE 
damageeventtilerange WIDEMONITOR WIDEMONITORBROKE 
damageeventtilerange WIDEMONITORDUALSCREEN WIDEMONITORDUALSCREENBROKE 
damageeventtilerange SMALLMONITOR1 SMALLMONITORBROKE 
damageeventtilerange SMALLMONITOR2 SMALLMONITORBROKE 
damageeventtilerange SMALLMONITOR3 SMALLMONITORBROKE 
damageeventtilerange SMALLMONITOR4 SMALLMONITORBROKE 
damageeventtilerange LONGMONITOR1 LONGMONITORBROKE 
damageeventtilerange LONGMONITOR2 LONGMONITORBROKE 
damageeventtilerange LONGMONITOR3 LONGMONITORBROKE 

onevent EVENT_DAMAGEWALL 
{
    ife wall[RETURN].picnum TERMINAL1 { sound VENT_BUST setw[RETURN].picnum TERMINALBROKE } 
    ife wall[RETURN].picnum TERMINAL2 { sound VENT_BUST setw[RETURN].picnum TERMINALBROKE } 
    ife wall[RETURN].picnum TERMINAL3 { sound VENT_BUST setw[RETURN].picnum TERMINALBROKE }
    ife wall[RETURN].picnum TERMINAL4 { sound VENT_BUST setw[RETURN].picnum TERMINALBROKE } 
    ife wall[RETURN].picnum HYBRIDCAPSULE { sound VENT_BUST sound GREYDEATH lotsofglass 20 setw[RETURN].picnum HYBRIDCAPSULEBROKE }
    // Note to self: go over these and replace GLASS_BREAKING  where appropriate 
    ife wall[RETURN].picnum THINMONITOR { sound GLASS_BREAKING lotsofglass 20 setw[RETURN].picnum THINMONITORBROKE } 
    ife wall[RETURN].picnum WIDEMONITOR { sound GLASS_BREAKING lotsofglass 20 setw[RETURN].picnum WIDEMONITORBROKE }
    ife wall[RETURN].picnum WIDEMONITORDUALSCREEN { sound GLASS_BREAKING lotsofglass 20 setw[RETURN].picnum WIDEMONITORDUALSCREENBROKE }
    ife wall[RETURN].picnum SMALLMONITOR1 { sound VENT_BUST setw[RETURN].picnum SMALLMONITORBROKE } 
    ife wall[RETURN].picnum SMALLMONITOR2 { sound VENT_BUST setw[RETURN].picnum SMALLMONITORBROKE } 
    ife wall[RETURN].picnum SMALLMONITOR3 { sound VENT_BUST setw[RETURN].picnum SMALLMONITORBROKE } 
    ife wall[RETURN].picnum SMALLMONITOR4 { sound VENT_BUST setw[RETURN].picnum SMALLMONITORBROKE } 
    ife wall[RETURN].picnum LONGMONITOR1 { sound VENT_BUST setw[RETURN].picnum LONGMONITORBROKE } 
    ife wall[RETURN].picnum LONGMONITOR2 { sound VENT_BUST setw[RETURN].picnum LONGMONITORBROKE } 
    ife wall[RETURN].picnum LONGMONITOR3 { sound VENT_BUST setw[RETURN].picnum LONGMONITORBROKE } 
}
endevent

action GASPUMPFRAME     0   3   1   1   15
actor GASPUMP 26
  fall
  cstator 257 
  ifaction GASPUMPFRAME
  {
    ifactioncount 2
    {
      hitradius 1024 WEAKEST WEAK MEDIUMSTRENGTH TOUGH
      spawn EXPLOSION2
      debris SCRAP2 2
      sound PIPEBOMB_EXPLODE
      killit
    }
    break
  }
  ifsquished
  {
    debris SCRAP1 5
    killit
    break
  }
  ifhitweapon
    action GASPUMPFRAME
enda

