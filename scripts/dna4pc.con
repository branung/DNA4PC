dynamicremap

// Variables, statics and sound/level/music definitions
include scripts/redefs.con
include game.con
include scripts/dnadef.con
include scripts/actors.con
include scripts/breakable.con
include scripts/dialogdef.con
include scripts/effects.con
include scripts/screens.con
include scripts/cutscenes.con
include scripts/hud.con
// WEAPON DEFINES, I'm too lazy so I stole the sample from sdk/samples/weapons.sample.con
// Thanks Hendricks!
include scripts/weapons.con

damageeventtile 1405

// Display mod version in logs
definequote 165 DNA4PC v0.99
appendevent EVENT_INITCOMPLETE
    userquote 165
endevent

onevent EVENT_NEWGAME
    readgamevar dna_localization
    readgamevar dna_cutscenes
    readgamevar dna_dukecutscenevoc
    readgamevar dna_menu_tutorial
    readgamevar dna_level_music
    readgamevar dna_crosshair
    readgamevar dna_key_hud
endevent

//Remove D3D loading screen
onevent EVENT_GETLOADTILE
    setvar RETURN -1
endevent

// Change overhead map icon to DNA Duke head
onevent EVENT_DISPLAYOVERHEADMAPPLAYER
{
    set RETURN DNAMAPDUKEHEAD // Pretty small on screen, if resizing possible when its drawn that'd be good
}
endevent

onevent EVENT_SPAWN
    switch sprite[].picnum
        //Set all Liztroops to blue on spawn rather than the hardcoded green 
        case LIZTROOP seta[].pal 0 break
        case LIZTROOPRUNNING seta[].pal 0 break
        case LIZTROOPSTAYPUT seta[].pal 0 break
        case LIZTROOPJETPACK seta[].pal 0 break
        // Resize standard health pickups
        case SIXPAK {
            getuserdef .player_skill temp
            geta[].lotag temp2
            ifg temp2 temp break
            else seta[].xrepeat 58 seta[].yrepeat 50 break
        } 
        case COLA {
            getuserdef .player_skill temp
            geta[].lotag temp2
            ifg temp2 temp break
            else seta[].xrepeat 48 seta[].yrepeat 40 break
        }
    endswitch

    // Disable monster respawn
    setvar RESPAWN_MONSTERS 0
endevent

appendevent EVENT_PRELEVEL
  state cutscene_cleanup
  state endscreen_cleanup
  setvar worldprevtick -1
  setvar SCREENALPHAWORLD 255
  set played_camquote 0
  setp[myconnectindex].max_ammo_amount 12 100
endevent

appendevent EVENT_ENTERLEVEL
    // Don't show level name
    setuserdef .show_level_text 0

    // Prevent knuckle cracking animation at level start
    getplayer[THISACTOR].knuckle_incs temp
	ifvarg temp 0 
	{
		setplayer[THISACTOR].knuckle_incs 0
	}
    // For dna_level_music - check if level music is set to off and if so set level's theme out of bounds so that nothing plays
    ifvare dna_level_music 1
    {
        stopallmusic   
        starttrackslot 5 20
    }
endevent

appendevent EVENT_LOADGAME
    ifvare dna_level_music 1
    {
        stopallmusic   
        starttrackslot 5 20
    }
endevent

onevent EVENT_DISPLAYCROSSHAIR
    switch dna_crosshair
        case 1 { setvar RETURN 5744 break }
        case 2 { setvar RETURN 5745 break }
        case 3 { setvar RETURN 5746 break }
        case 4 { setvar RETURN 5747 break }
        case 5 { setvar RETURN 5748 break }
        case 6 { setvar RETURN 5749 break }
        case 7 { setvar RETURN 5750 break }
        case 8 { setvar RETURN 5751 break }
        default { setvar RETURN 5743 break }
    endswitch
endevent

appendevent EVENT_ANIMATESPRITES
{
    switch sprite[].picnum
    case VIEWSCREEN
        settspr[].tsprpicnum sprite[].picnum
        settspr[].tsprxrepeat sprite[].xrepeat
        settspr[].tspryrepeat sprite[].yrepeat
        settspr[].tsprcstat sprite[].cstat
        break
    endswitch
}
endevent

onevent EVENT_GAME
    ifactor APLAYER
    {
		getplayer[THISACTOR].jumping_counter temp
		ifvare temp 721 
		{
			setplayer[THISACTOR].jumping_counter 0 //Limit jump height
		}

        getplayer[THISACTOR].on_ground temp
		ifvare temp 1 
		{
			setplayer[THISACTOR].jumping_toggle 0 //Allows for continous jumping with the button held - a movement quirk in the original
		}
    
        // Override for episode endings
        setuserdef .eog 0
        ifvare VOLUME 0 ifvare LEVEL 19 setuserdef .eog 1

        geta[THISACTOR].extra temp
        ifvarg temp 0 
        {
            set player_health temp
        }
    }
endevent

// Prepending this state to override player insta kill when being crushed
prependstate random_ooz
    ifactor APLAYER 
    {
      stopactorsound THISACTOR SQUISHED
      seta[THISACTOR].extra player_health
      //addphealth -4
      sound ADUKE_SEARCH
      palfrom 32 64
      // Check if Squish! message is displayed to prevent it from showing
      ife player[].ftq 10 
      {
        setp[].fta 0
      }
      terminate
    }
ends