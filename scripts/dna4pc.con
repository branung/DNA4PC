dynamicremap

// Variables, statics and sound/level/music definitions
include scripts/redefs.con
include game.con
include scripts/dnadef.con
include scripts/actors.con
include scripts/breakable.con
include scripts/dialogdef.con
include scripts/effects.con
include scripts/cutscenes.con
include scripts/hud.con
// WEAPON DEFINES, I'm too lazy so I stole the sample from sdk/samples/weapons.sample.con
// Thanks Hendricks!
include scripts/weapons.con

damageeventtile 1405

onevent EVENT_NEWGAME
    readgamevar dna_localization
    readgamevar dna_cutscenes
    readgamevar dna_dukecutscenevoc
    readgamevar dna_menu_tutorial
    readgamevar dna_level_music
    readgamevar dna_crosshair
    readgamevar dna_key_hud
endevent

//Replace D3D loading screen
onevent EVENT_GETLOADTILE
    setvar RETURN 5753
endevent

//Set all Liztroops to blue on spawn rather than the hardcoded green 
onevent EVENT_SPAWN
    switch sprite[].picnum
        case LIZTROOP seta[].pal 0 break
        case LIZTROOPRUNNING seta[].pal 0 break
        case LIZTROOPSTAYPUT seta[].pal 0 break
        case LIZTROOPJETPACK seta[].pal 0 break
    endswitch

    // Disable monster respawn
    setvar RESPAWN_MONSTERS 0
endevent

var viewscreen_spr 0 0

appendevent EVENT_PRELEVEL
  setp[myconnectindex].max_ammo_amount 12 100
  for viewscreen_spr allsprites
  {
    ifvare sprite[viewscreen_spr].picnum VIEWSCREEN
    {
        setactor[viewscreen_spr].mdflags 16
                    
    }
  }
endevent


appendevent EVENT_ENTERLEVEL
    // Prevent knuckle cracking animation at level start
    getplayer[THISACTOR].knuckle_incs temp
	ifvarg temp 0 
	{
		setplayer[THISACTOR].knuckle_incs 0
	}
    // For dna_level_music - check if level music is set to off and if so set level's theme out of bounds so that nothing plays
    ifvare dna_level_music 1
    {
        stopallmusic   
        starttrackslot 5 20
    }
endevent

appendevent EVENT_LOADGAME
    ifvare dna_level_music 1
    {
        stopallmusic   
        starttrackslot 5 20
    }
endevent

onevent EVENT_DISPLAYCROSSHAIR
    ifvare dna_crosshair 1 { setvar RETURN 5744 }
    else ifvare dna_crosshair 2 { setvar RETURN 5745 }
    else ifvare dna_crosshair 3 { setvar RETURN 5746 }
    else ifvare dna_crosshair 4 { setvar RETURN 5747 }
    else ifvare dna_crosshair 5 { setvar RETURN 5748 }
    else ifvare dna_crosshair 6 { setvar RETURN 5749 }
    else ifvare dna_crosshair 7 { setvar RETURN 5750 }
    else ifvare dna_crosshair 8 { setvar RETURN 5751 }
    else { setvar RETURN 5743 }
endevent

appendevent EVENT_ANIMATESPRITES
{
    switch sprite[].picnum
    case VIEWSCREEN
        settspr[].tsprpicnum sprite[].picnum
        settspr[].tsprxrepeat sprite[].xrepeat
        settspr[].tspryrepeat sprite[].yrepeat
        settspr[].tsprcstat sprite[].cstat
        break
    endswitch
}
endevent

onevent EVENT_GAME
    ifactor APLAYER
    {
		getplayer[THISACTOR].jumping_counter temp
		ifvare temp 721 
		{
			setplayer[THISACTOR].jumping_counter 0 //Limit jump height
		}

        getplayer[THISACTOR].on_ground temp
		ifvare temp 1 
		{
			setplayer[THISACTOR].jumping_toggle 0 //Allows for continous jumping with the button held - a movement quirk in the original
		}
    
        // Override for episode endings
        setuserdef .eog 0
        ifvare VOLUME 0 ifvare LEVEL 19 setuserdef .eog 1

        geta[THISACTOR].extra temp
        ifvarg temp 0 
        {
            set player_health temp
        }
    }
endevent

// Prepending this state to override player insta kill when being crushed
prependstate random_ooz
    ifactor APLAYER 
    {
      stopactorsound THISACTOR SQUISHED
      seta[THISACTOR].extra player_health
      addphealth -4
      sound ADUKE_SEARCH
      palfrom 32 64
      // Check if Squish! message is displayed to prevent it from showing
      ife player[].ftq 10 
      {
        setp[].fta 0
      }
      terminate
    }
ends

// End level screen events
onevent EVENT_GETBONUSTILE
{
    // cleanup called to reset values used for fadeout in bonus screen
    state cutscene_cleanup
    setuserdef[THISACTOR].return 0 -1
    setuserdef[THISACTOR].return 1 -1
    setuserdef[THISACTOR].return 2 -1
    setuserdef[THISACTOR].return 3 -1
    setuserdef[THISACTOR].return 4 -1
}
endevent

onevent EVENT_DISPLAYBONUSSCREEN
{
    state screen_fadeout
    rotatesprite 160 100 65536 0 5761 0 0 72 0 0 xdim ydim
    rotatesprite 160 30 81920 0 5762 0 0 8 0 0 xdim ydim
    screentext BIGALPHANUM 160 21 81920 0 0 132 0 0 16 0 8 0 0 0 2 0 0 xdim ydim

    // Kill count
    setvar y 64
    screentext BIGALPHANUM 86 y 81920 0 0 133 0 0 16 0 8 0 0 0 2 0 0 xdim ydim
    getplayer[THISACTOR].actors_killed temp
    getplayer[THISACTOR].max_actors_killed temp2
    redefinequote 134 %d/%d
    qsprintf 134 134 temp temp2
    screentext BIGALPHANUM 230 y 81920 0 0 134 0 0 16 0 8 0 0 0 2 0 0 xdim ydim
    addvar y 24

    // Secret count
    screentext BIGALPHANUM 110 y 81920 0 0 135 0 0 16 0 8 0 0 0 2 0 0 xdim ydim
    getplayer[THISACTOR].secret_rooms temp
    getplayer[THISACTOR].max_secret_rooms temp2
    redefinequote 134 %d/%d
    qsprintf 134 134 temp temp2
    screentext BIGALPHANUM 240 y 81920 0 0 134 0 0 16 0 8 0 0 0 2 0 0 xdim ydim
    addvar y 24

    // Time
    screentext BIGALPHANUM 85 y 81920 0 0 136 0 0 16 0 8 0 0 0 2 0 0 xdim ydim
    //getplayer[THISACTOR].max_secret_rooms temp2
    qgetsysstr 134 STR_YOURTIME 
    screentext BIGALPHANUM 215 y 81920 0 0 134 0 0 16 0 8 0 0 0 2 0 0 xdim ydim
    addvar y 24

    // Par Time
    screentext BIGALPHANUM 85 y 81920 0 0 137 0 0 16 0 8 0 0 0 2 0 0 xdim ydim
    qgetsysstr 134 STR_PARTIME 
    screentext BIGALPHANUM 232 y 81920 0 0 134 0 0 16 0 8 0 0 0 2 0 0 xdim ydim
    addvar y 24
    
    // Best Time - Only shown when player has a previous record
    qgetsysstr 134 STR_BESTTIME
    qstrcmp 134 139 temp
    ifvarn temp 0 {
        screentext BIGALPHANUM 90 y 81920 0 0 138 0 0 16 0 8 0 0 0 2 0 0 xdim ydim
        screentext BIGALPHANUM 215 y 81920 0 0 134 0 0 16 0 8 0 0 0 2 0 0 xdim ydim
    }
    
}
endevent

// Disable various sounds on level complete screen
onevent EVENT_SOUND    
    getplayer[THISACTOR].gm temp
    ifvarand temp 8    
    {
        switch RETURN
        case FLY_BY
        case BONUS_SPEECH1
        case BONUS_SPEECH2
        case BONUS_SPEECH3
            set RETURN -1
            break
        case SHOTGUN_COCK
            setvar RETURN -1 
            globalsound A_PISTOL
            break
        case PIPEBOMB_EXPLODE
            ifvarn CUTSCENE_STEP 3 { setvar RETURN -1 }
            break
        endswitch
    }
endevent