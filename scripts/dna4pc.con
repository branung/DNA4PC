dynamicremap

// Variables, statics and sound/level/music definitions
include scripts/dnadef.con
include scripts/actors.con
include scripts/breakable.con
include scripts/dialogdef.con
include scripts/cutscenes.con
include scripts/hud.con
include scripts/effects.con

damageeventtile 1405


// Moved from GAME.CON
// should go under APLAYER actor's ifhitweapon
//    ifwasweapon GREYPROJECTILE
//      palfrom 16 0 32 32
//    ifwasweapon SLIMECRABPROJECTILE
//      palfrom 16 0 64
//    ifwasweapon ALIENLORDPROJECTILE
//      palfrom 48 32 
// Moved from GAME.CON



onevent EVENT_NEWGAME
    readgamevar dna_localization
    readgamevar dna_dukecutscenevoc
    readgamevar dna_menu_tutorial
endevent

//Set all Liztroops to blue on spawn rather than the hardcoded green 
onevent EVENT_SPAWN
    switch sprite[].picnum
        case LIZTROOP seta[].pal 0 break
        case LIZTROOPRUNNING seta[].pal 0 break
        case LIZTROOPSTAYPUT seta[].pal 0 break
        case LIZTROOPJETPACK seta[].pal 0 break
    endswitch
endevent

var viewscreen_spr 0 0

appendevent EVENT_PRELEVEL
  for viewscreen_spr allsprites
  {
    ifvare sprite[viewscreen_spr].picnum VIEWSCREEN
    {
        setactor[viewscreen_spr].mdflags 16
                    
    }
  }
endevent

appendevent EVENT_ANIMATESPRITES
{
    switch sprite[].picnum
    case VIEWSCREEN
        settspr[].tsprpicnum sprite[].picnum
        settspr[].tsprxrepeat sprite[].xrepeat
        settspr[].tspryrepeat sprite[].yrepeat
        settspr[].tsprcstat sprite[].cstat
        break
    endswitch
}
endevent

onevent EVENT_GAME
    ifactor APLAYER
    {
		getplayer[THISACTOR].jumping_counter temp
		ifvare temp 721 
		{
			setplayer[THISACTOR].jumping_counter 0 //Limit jump height
		}
        // Override for episode endings
        setuserdef .eog 0
        ifvare VOLUME 5 ifvare LEVEL 19 setuserdef .eog 1
    }
    endevent

