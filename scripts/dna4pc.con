include scripts/dnadef.con

gamevar WEAPON1_CLIP 0 0 // Prevent pistol from reloading
gamevar WEAPON1_TOTALTIME 9 // Increases delay time between each pistol shot
gamevar temp 0 2

// Disable all cutscenes
gamevar LOGO_FLAGS 2095359 0

// Override for episode endings
onevent EVENT_GAME
    ifactor APLAYER
    {
		getplayer[THISACTOR].jumping_counter temp
		ifvare temp 721 
		{
			setplayer[THISACTOR].jumping_counter 0 //Limit jump height
		}
        setuserdef .eog 0
        ifvare VOLUME 0 ifvare LEVEL 19 setuserdef .eog 1
    }
endevent

// Episodes
definevolumename 0 Duke Advance

// Levels
definelevelname 0 0 maps/MAP01.map  00:00 00:00 Gathering Intel
definelevelname 0 1 maps/MAP02.map 00:00 00:00 Close Encounter
definelevelname 0 2 maps/MAP03.map 00:00 00:00 Hybrid Army
definelevelname 0 3 maps/MAP04.map 00:00 00:00 Temple of Amun
definelevelname 0 4 maps/MAP05.map 00:00 00:00 Inner Sanctum
definelevelname 0 5 maps/MAP06.map 00:00 00:00 The Controller
definelevelname 0 6 maps/MAP07.map 00:00 00:00 Temple Escape
definelevelname 0 7 maps/MAP08.map 00:00 00:00 Down Under
definelevelname 0 8 maps/MAP09.map 00:00 00:00 Eating Out
definelevelname 0 9 maps/MAP10.map 00:00 00:00 Day at the Opera
definelevelname 0 10 maps/MAP11.map 00:00 00:00 Doomsday Weapon
definelevelname 0 11 maps/MAP12.map 00:00 00:00 Alien Ship
definelevelname 0 12 maps/MAP13.map 00:00 00:00 Cloaking Device
definelevelname 0 13 maps/MAP14.map 00:00 00:00 Mazeframe
definelevelname 0 14 maps/MAP15.map 00:00 00:00 Jenny 2
definelevelname 0 15 maps/MAP16.map 00:00 00:00 Jenny 3
definelevelname 0 16 maps/MAP17.map 00:00 00:00 Jenny 4
definelevelname 0 17 maps/MAP18.map 00:00 00:00 Alien Lord
definelevelname 0 18 maps/MAP19.map 00:00 00:00 Run Your Ass Off!

// Music
music 1 
//Level 1    Level 2     Level 3    Level 4    Level 5     Level 6    Level 7    Level 8   Level 9      Level 10     Level 11 Level 12  Level 13     Level 14    Level 15   Level 16   Level 17     Level 18     Level 19
restrict.mid xplasma.mid alienz.mid snake1.mid thecall.mid gloomy.mid ahgeez.mid prepd.mid inhiding.mid watrwld1.mid pob.mid  storm.mid warehaus.mid intents.mid stalag.mid spook.mid  robocrep.mid gutwrnch.mid depart.mid
