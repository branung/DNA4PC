useractor notenemy DNA_REDKEY 0
    sizeat 52 44
    state access_shared
enda
useractor notenemy DNA_YELLOWKEY 0
    sizeat 52 44
    state access_shared
enda

// Handles freezing enemies, negates freezer damage which avoids old freezing logic
state newEnemyFreeze
  geta [].htpicnum temp
  ife temp FREEZEBLAST {
    seta [].htextra -1
    ifg sprite[THISACTOR].extra 0
    {
      sound SOMETHINGFROZE
      spritepal 1
      move 0
      //resetcount
      seta [].htpicnum sprite[THISACTOR].picnum
      switch sprite[THISACTOR].picnum
        case LIZTROOP action ATROOPFROZEN break
        case PIGCOP action APIGFROZEN break
        case LIZMAN action ALIZFROZEN break
        case OCTABRAIN action AOCTAFROZEN break
        case GREY ai AIGREYFROZEN break
        case SLIMECRAB ai AICRABFROZEN break
        case SLIMEREGG ai AISLIMEREGGFROZEN break
        case NEWBEASTHANG action NEWBEASTHANG break
      endswitch
    }
  }
ends

//// --------- PREPENDS FOR FREEZING ENEMIES ---------
prependstate troopcode
    state newEnemyFreeze
ends

prependstate checksquished
  ifactor PIGCOP { state newEnemyFreeze }
  ifactor LIZMAN { state newEnemyFreeze }
  ifactor OCTABRAIN { state newEnemyFreeze }
  ifactor GREY { state newEnemyFreeze }
  ifactor SLIMECRAB { state newEnemyFreeze }
  ifactor SLIMEREGG { state newEnemyFreeze }
  // Needs to be tested.. also need to add commander
  ifactor NEWBEASTHANG {
    state newEnemyFreeze
  }
ends

//// --------- EXTRA REVIVE FUNCTION FOR GREY ---------
// This hijacks into the common "checksquished" state from original GAME.CON
// The enemy currently supports reviving trooper/pigcop/octa/newbeast.
appendstate checksquished

    ifaction ATROOPDEAD {
        findnearspritez GREYREVIVEPROJECTILE GREYPROJECTILEREVIVEXY GREYPROJECTILEREVIVEZ temp
        ifn temp -1 {
            addkills -1
            spawn TRANSPORTERSTAR
            cstat 257
            strength TROOPSTRENGTH
            ai AITROOPSEEKENEMY
        }
    }
    ifaction ALIZLYINGDEAD {
        findnearspritez GREYREVIVEPROJECTILE GREYPROJECTILEREVIVEXY GREYPROJECTILEREVIVEZ temp
        ifn temp -1 {
            addkills -1
            spawn TRANSPORTERSTAR
            cstat 257
            strength LIZSTRENGTH
            ai AILIZGETENEMY
        }
    }
    ifaction AOCTADEAD {
        findnearspritez GREYREVIVEPROJECTILE GREYPROJECTILEREVIVEXY GREYPROJECTILEREVIVEZ temp
        ifn temp -1 {
            addkills -1
            spawn TRANSPORTERSTAR
            cstat 257
            strength OCTASTRENGTH
            ai AIOCTAGETENEMY
        }
    }
    ifaction APIGDEAD {
        findnearspritez GREYREVIVEPROJECTILE GREYPROJECTILEREVIVEXY GREYPROJECTILEREVIVEZ temp
        ifn temp -1 {
            addkills -1
            spawn TRANSPORTERSTAR
            cstat 257
            strength PIGCOPSTRENGTH
            ai AIPIGSEEKENEMY
        }
    }
    ifaction ANEWBEASTLYINGDEAD {
        findnearspritez GREYREVIVEPROJECTILE GREYPROJECTILEREVIVEXY GREYPROJECTILEREVIVEZ temp
        ifn temp -1 {
            addkills -1
            spawn TRANSPORTERSTAR
            cstat 257
            strength NEWBEASTSTRENGTH
            ai AINEWBEASTGETENEMY
        }
    }
ends

