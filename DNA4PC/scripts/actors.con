// Moved from GAME.CON
actor LEAD_CANNON_SPRITE
  fall
  ifmove RESPAWN_ACTOR_FLAG
    state respawnit
  else
    ifp pshrunk nullop
    else
      ifp palive
        ifpdistl RETRIEVEDISTANCE
          ifcount 6
            ifcanseetarget
      {
          ifgotweaponce 0
            break

        addweapon LEAD_WEAPON 1
        ifn player.ammo_amount SHOTGUN_WEAPON MAXSHOTGUNAMMO
            addammo SHOTGUN_WEAPON 10
            
            quote 125
          
        state transfer_lead_ammo
        ifspawnedby LEAD_CANNON_SPRITE
            state getweaponcode
          else
            state quikweaponget
        }
enda
