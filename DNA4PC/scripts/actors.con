defstate enemy_fxload
    // For now just process HTIAG to fx_hitag for enemies!
    geta .hitag fx_hitag
    seta .hitag 0
    geta .extra fx_extra
    seta .extra -1
ends

defstate enemy_deathtrigger
    ifn fx_hitag 0 {
        setarray fx_preactivate[fx_hitag] 1
        setvar fx_hitag 0
    }

    ifn fx_extra -1 {
        espawnvar fx_extra
        setvar fx_extra -1
    }
ends

// Below is a custom get code state for the various sound effects pick ups have.
// Following it are prepends for the standard get states in order to override 
// their behavior and add the dna_getcode. Palfrom are also removed (Might be added back as a toggle)
defstate dna_getcode
  geta[THISACTOR].picnum temp
  switch temp
  case ATOMICHEALTH
    globalsound GETATOMICHEALTH
    break
  case SHIELD
  case ARMORSHARD
    globalsound A_PICKARMOR
    break
  case DNA_BLUEKEY
  case DNA_REDKEY
  case DNA_YELLOWKEY
  case DNA_SYSKEY
  case DNA_CDKEY
  case DNA_CHIPKEY
    globalsound A_ACTIVATE
    break
  case SIXPAK
  case HEALTHPACKSMALL
  case COLA
    globalsound ADUKE_USEMEDKIT2
    break
  default
    globalsound A_PICKWEAPON
    break
  endswitch
ends

prependstate getcode
  state dna_getcode
  //palfrom 16 0 32
  ifrespawn
  {
    move RESPAWN_ACTOR_FLAG
    spawn RESPAWNMARKERRED
    cstat 32768
  }
  else
    killit
terminate
ends

prependstate quikget
  state dna_getcode
  //palfrom 16 0 32
  killit
  terminate
ends

// Gives a chance for Duke to not say anything for weapon pickups mainly due to increased drop rate of shotguns
prependstate randgetweapsnds
  ifrnd 32
    globalsound DUKE_GETWEAPON1
  else
    ifrnd 32
      globalsound DUKE_GETWEAPON2
  else
    ifrnd 32
      globalsound DUKE_GETWEAPON3
  else
    ifrnd 32
      globalsound DUKE_GETWEAPON4
  else
    ifrnd 32
      globalsound DUKE_GETWEAPON6
  terminate
ends

prependstate getweaponcode

  globalsound A_PICKWEAPON
  state randgetweapsnds

  //palfrom 32 0 32
  ifgotweaponce 1
    break
  ifrespawn
  {
    move RESPAWN_ACTOR_FLAG
    spawn RESPAWNMARKERRED
    cstat 32768
  }
  else
    killit
  terminate
ends


prependstate quikweaponget
  globalsound A_PICKWEAPON
  state randgetweapsnds
  //palfrom 32 0 32
  ifgotweaponce 1
    break
  killit
  terminate
ends

// Remove Enforcer's chance to drop gun and only drop ammo
prependstate drop_chaingun
  ifrnd SPAWNAMMOODDS
  {
    spawn BATTERYAMMO
  }
  terminate
ends

// Also have to copy this whole state just to remove the shield drop chance
prependstate checkpighitstate
  spawn BLOOD
  ifdead
  {
    state random_wall_jibs
    state drop_shotgun
    ifwasweapon GROWSPARK
    {
      sound ACTOR_GROWING
      ai AIPIGGROW
      break
    }

    addkills 1

    ifwasweapon RADIUSEXPLOSION
    {
      sound SQUISHED
      state standard_jibs
      killit
    }
    else
      ifwasweapon RPG
    {
      sound SQUISHED
      state standard_jibs
      killit
    }
    else
      ai AIPIGDYING
        sound PIG_DYING
  }
  else
  {
    // ifwasweapon FREEZEBLAST
    // {
    //   sound SOMETHINGFROZE
    //   spritepal 1
    //   move 0
    //   action APIGFROZEN
    //   //strength 0
    //   terminate
    // }

    sound PIG_PAIN
    state random_wall_jibs

    ifwasweapon SHRINKSPARK
    {
      sound ACTOR_SHRINKING
      ai AIPIGSHRINK
    }
    else
      ifwasweapon GROWSPARK
        sound EXPANDERHIT
    else
      ifrnd 32
        ai AIPIGHIT
    else
      ifrnd 64
        ai AIPIGSHOOTENEMY
    else
      ifrnd 64
      {
        ai AIPIGDIVING
        action APIGDIVESHOOT
      }
  }
  terminate
ends


