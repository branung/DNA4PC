//// --------- KEYITEM ACTOR ---------
// Generic pickup for key items
// Hitag: Triggered when picked up
defstate access_shared
    fall
    ifmove RESPAWN_ACTOR_FLAG {
        state respawnit
    } else {
        ifp pshrunk {
            nullop
        } else {
            ifp palive {
                ifpdistl RETRIEVEDISTANCE {
                    ifcount 6 {
                        ifcanseetarget {
                            getplayer[].got_access temp
                            ifactor DNA_BLUEKEY { 
                                or temp lock_bluekey
                                redefinequote DNA_KEYQUOTE Blue key card
                            }
                            ifactor DNA_REDKEY {
                                or temp lock_redkey
                                redefinequote DNA_KEYQUOTE Red key card
                            }
                            ifactor DNA_YELLOWKEY {
                                or temp lock_yellowkey
                                redefinequote DNA_KEYQUOTE Yellow key card
                            }
                            ifactor DNA_SYSKEY {
                                or temp lock_syskey
                                redefinequote DNA_KEYQUOTE Accessed the computer
                            }
                            ifactor DNA_CDKEY {
                                or temp lock_cdkey
                                redefinequote DNA_KEYQUOTE Data Disc
                            }
                            ifactor DNA_CHIPKEY {
                                or temp lock_chipkey
                                redefinequote DNA_KEYQUOTE Schematics
                            }
                            setplayer[].got_access temp

                            state enemy_fxload
                            state enemy_deathtrigger
                            ifn sprite.hitag 0 { operateactivators sprite.hitag -1 }
                            quote DNA_KEYQUOTE
                            state getcode
                        }
                    }
                }
            }
        }
    }
ends

useractor notenemy DNA_SYSKEY 0
    state access_shared
enda
useractor notenemy DNA_CDKEY 0
    state access_shared
enda
useractor notenemy DNA_CHIPKEY 0
    state access_shared
enda
