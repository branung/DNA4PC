                                case 8 { ife dna_localization 1 set skip_this_panel 1 else { set CUTSCENE_SPRITE DUKEHEADSPRITE ife dna_dukecutscenevoc 2 { set curr_cuts_voc GM_BETONDUKE } } break }
                                endswitch
