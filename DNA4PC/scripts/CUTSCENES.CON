// Special thanks to Hendricks266's World Tour stopgap code. 
// This script utilizes the implementation of the audio commentary feature and reworks it to function as cutscene triggers
// Also big thanks to the Cutting Room Floor for having a full page showing both scripts to this game 


var cutscene_myvar 0 2



move SPACEPRESSED

define CUTSCENEINDICATOR 5397
define CUTSCENEINDICATOR_ACTIVE 5398
define CUTSCENEINDICATOR_OFF 5399

define OPCUTSCENE1 5507
define OPCUTSCENE2 5508
define OPCUTSCENE3 5509
define OPCUTSCENE4 5510
define OPCUTSCENE5 5511
define OPCUTSCENE6 5512
define OPCUTSCENE7 5513
define OPCUTSCENE8 5514
define OPCUTSCENE9 5515
define OPCUTSCENE10 5516
define OPCUTSCENE11 5517
define OPCUTSCENE12 5518
define OPCUTSCENEDUKESPRITE 5519
define OPCUTSCENEDIALOG1 5520
define OPCUTSCENEDIALOG2 5521

// Defines for cutscene slide animation times so they can be adjusted from here
define OPSLIDEINTIME 520
define OP12SLIDEINTIME 420
define OPDUKESLIDEINTIME 520
// gamevars for current slide animation times
gamevar OPCUTSCENESLIDEINTIME OPSLIDEINTIME
gamevar OPCUTSCENE12SLIDEINTIME OP12SLIDEINTIME
gamevar OP12DUKESLIDEINTIME OPDUKESLIDEINTIME

var curr_cutscene -1 // Tracks current panel
var skip_this_panel 0 // Forcefully skips the panel it's on. Only needed for localization differences
var dont_stop_sounds 0 // Set to 1 to prevent stopallsounds from being called, useful for letting the sound of a pickup play into the cutscene it triggers

gamevar cutscene_length 0 0
var cutscene_killswitch_start 0
define cutscene_quote_check 190
definequote cutscene_quote_check TEST
gamevar kill_cutscene 0 0
define KILLSWITCH_LINE 191
definequote KILLSWITCH_LINE /!&
define newTextQuote 192
definequote newTextQuote TEMP QUOTE STORAGE
var curr_quote 0

var OPCUTSCENEPOS 160
define OPCUTSCENE12POS 95
define OPCUTSCENE12DUKEPOS 40

define ENDCUTSCENE1 5523
define ENDCUTSCENE2 5524
define ENDCUTSCENE3 5525
define ENDCUTSCENE4 5526
define ENDCUTSCENE5 5527
define ENDCUTSCENE6 5528
define ENDCUTSCENE7 5529
define ENDCUTSCENE8 5530
define ENDCUTSCENE9 5531
define ENDCUTSCENEDIA1 5532
define ENDCUTSCENEDIA2 5533
define ENDCUTSCENEDIA3 5534
define ENDCUTSCENEDIA4 5535
define ENDCUTSCENEDIA5 5536
gamevar ENDDIA1SLIDEINTIME 300
gamevar ENDDIA2SLIDEINTIME 300
gamevar ENDDIA3SLIDEINTIME 220
var ENDCUTSCENEDIAPOSX1 140
var ENDCUTSCENEDIAPOSX2 240
var ENDCUTSCENEDIAPOSY1 180
var ENDCUTSCENEDIAPOSY2 20

define OP_CUTSCENE_DELAY_TIME 3000
define CUTSCENE_DELAY_TIME 300


defstate waste_time
{
  ifvarg delayTime 0
  {
        setvar RETURN 0
        getticks curtick
        ifvare prevtick -1 setvar ticktmp 0 else
        {
        setvarvar ticktmp curtick
        subvarvar ticktmp prevtick
        }

        subvarvar delayTime ticktmp
        //addlogvar delayTime
        
        setvarvar prevtick curtick
  }
  else {
    setvar prevtick -1
  }
}
ends

defstate cutscene_cleanup
        ifvarn SCREENALPHA 255
                setvar SCREENALPHA 255
        ifvarn CUTSCENE_STEP 0
                setvar CUTSCENE_STEP 0
        ifvarn prevtick -1
                setvar prevtick -1
        ifn curr_cutscene -1
                set curr_cutscene -1
        ifn kill_cutscene 0
                set kill_cutscene 0
        ifn textQuoteRow1 201
                set textQuoteRow1 201 // default to line 201 for new dialog
ends

defstate op_cutscene_cleanup
        ifvarn OPCUTSCENESLIDEINTIME OPSLIDEINTIME
                setvar OPCUTSCENESLIDEINTIME OPSLIDEINTIME
        ifvarn OPCUTSCENE12SLIDEINTIME OP12SLIDEINTIME
                setvar OPCUTSCENE12SLIDEINTIME OP12SLIDEINTIME
        ifvarn OP12DUKESLIDEINTIME OPDUKESLIDEINTIME
                setvar OP12DUKESLIDEINTIME OPDUKESLIDEINTIME
        ifvarn in_opening_cutscene 1
                setvar in_opening_cutscene 1
ends

defstate cutscene_getscene
    ifvare cutscene_myvar 0
    {
        getactor[].lotag cutscene_myvar
        setactor[].lotag 0
    }
    geta .hitag fx_hitag
    seta .hitag 0
ends

useractor notenemy CUTSCENEINDICATOR 0

    geta .cstat temp
    ifand temp 32768 {
        ife fx_activate[fx_hitag] 1 {
            set cutscene_num cutscene_myvar
            set in_cutscene 1
        }
    } else {

        ifpdistl 1266
        ifp pfacing
        {
            ifhitspace
                move SPACEPRESSED
            else ifmove SPACEPRESSED
            {
                move 0
                for cutscene_i allsprites
                {
                    cactor CUTSCENEINDICATOR_ACTIVE
                    
                    ifvare sprite[cutscene_i].picnum CUTSCENEINDICATOR_ACTIVE
                    {
                            getactorvar[cutscene_i].cutscene_myvar cutscene_num
                        
                    }
                }
                
                setvar in_cutscene 1
                break
            }
        }
        else
            move 0
    }
enda
eventloadactor CUTSCENEINDICATOR
    state cutscene_getscene
    geta .cstat temp
    ifand temp 2 seta .cstat 32768
    
enda

useractor notenemy CUTSCENEINDICATOR_OFF 0

    ifpdistl 1266
    ifp pfacing
    {
        ifhitspace
            move SPACEPRESSED
        else ifmove SPACEPRESSED
        {
            move 0
            for cutscene_i allsprites
            {
                cactor CUTSCENEINDICATOR_ACTIVE
                
                ifvare sprite[cutscene_i].picnum CUTSCENEINDICATOR_ACTIVE
                {
                        getactorvar[cutscene_i].cutscene_myvar cutscene_num
                }
            }
            
            set in_cutscene 1
            break
        }
    }
    else
        move 0
enda
eventloadactor CUTSCENEINDICATOR_OFF
    state cutscene_getscene
enda


useractor notenemy CUTSCENEINDICATOR_ACTIVE 0

for cutscene_i allsprites
{
        ifvare sprite[cutscene_i].picnum CUTSCENEINDICATOR_ACTIVE
        {
                setactor[cutscene_i].picnum CUTSCENEINDICATOR_OFF
        }  
}  
enda

eventloadactor CUTSCENEINDICATOR_ACTIVE
enda

defstate end_cutscene
    screenpal 0 0 0 0
    set in_cutscene 0
ends

onevent EVENT_PRELEVEL
        state cutscene_cleanup
        getuserdef[].music_episode currmusic
        ifvarn currmusic 7
        {
                stopallmusic
                starttrackslot 7 0 
        }
        ifvare VOLUME 0
        {
                ifvare LEVEL 0 // AKA Level 1 - Gathering Intel
                {
                        state op_cutscene_cleanup
                        stopallsounds
                        screensound SHOTGUN_COCK
                        startscreen
                        setvar in_opening_cutscene 0
                }

                // Objective Screen
                setvar in_objective_screen 1
                startscreen
                screensound A_PISTOL
                startscreen
        }
endevent

appendevent EVENT_ENDLEVELSCREEN
        state cutscene_cleanup
        stopallmusic
        starttrackslot 7 0
        setvar delayTime END_SCREEN_INPUT_DELAY // This controls how long it takes until the player can skip the end level screen
        setvar in_endlevel_screen 1
        stopallsounds
        startscreen
        startscreen
        //setvar in_endlevel_screen 0
        ifvare VOLUME 0
        {
                ifvare LEVEL 19 
                {
                        state cutscene_cleanup
                        stopallsounds
                        setvar in_ending_cutscene 1
                        startscreen
                        stopallsounds
                        setvar in_ending_cutscene 0
                        setvar SCREENALPHA 255
                        set delayTime 1000
                        setvar in_credits 1
                        startscreen
                        startscreen
                }
        }
        setvar RETURN -1
endevent

defstate get_cutscene_details
{
        ife VOLUME 0
        {
                switch LEVEL
                case 0 // AKA Level 1 - Gathering Intel
                {
                        //LEVEL 1 OPENING SCENE
                        ife cutscene_num 1001
                        {       
                                switch CUTSCENE_STEP
                                case 0 { set CUTSCENE_SPRITE SARGEHEADSPRITE break } 
                                case 1 set CUTSCENE_SPRITE SARGEHEADSPRITE break 
                                case 3 { set CUTSCENE_SPRITE DUKEHEADSPRITE
                                        ife dna_localization 0 { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_IMONIT }
                                        else { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_TELEBROKE } break }
                                case 4 { ife dna_localization 0 { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_DAMNTELEMALFUNC }
                                        else { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_GONNAPAY } break }
                                case 5 { ife dna_localization 1 { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_SIGNCHECKS }
                                        else { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_NEWHARDWARE } break }
                                case 6 { ife dna_localization 1 { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_WHOWANTSSOME
                                        else ife dna_dukecutscenevoc 1 set curr_cuts_voc DUKE_GETWEAPON4 } //Who wants some! 
                                        else { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_LETSROCK2
                                        else ife dna_dukecutscenevoc 1 set curr_cuts_voc BONUS_SPEECH1 } break } //Let's rock
                                                
                                endswitch
                        }

                        //LEVEL 1 MID LEVEL SCENE
                        ife cutscene_num 1002
                        {
                                switch CUTSCENE_STEP
                                case 0 { set textQuoteRow1 229 set CUTSCENE_SPRITE DUKEHEADSPRITE set dont_stop_sounds 1
                                        ife dna_localization 0 { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_DATADISK  } else { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_DATADISKEU } break }
                                case 1 { ife dna_localization 0 set skip_this_panel 1
                                        ife dna_localization 1 { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_CONTAINSDETAILS } break }
                                case 2 set CUTSCENE_SPRITE SARGEHEADSPRITE break
                                case 3 { set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_localization 1 { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_ONMYWAY } else { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_PLENTYTOKICK } break }
                                case 4 { ife dna_localization 1 set skip_this_panel 1 else set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_localization 0 { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_DUKEOUT } break }
                                endswitch
                        }
                        break
                }
                case 1 //AKA Level 2 - Close Encounter
                {
                        ifvare cutscene_num 1001
                        {
                                switch CUTSCENE_STEP
                                case 0 { set CUTSCENE_SPRITE SARGEHEADSPRITE break }
                                case 1 { ifvare dna_localization 1 set skip_this_panel 1 break }
                                endswitch
                        }                      
                        //LEVEL 2 MID LEVEL SCENE
                        ifvare cutscene_num 1002
                        {
                                switch CUTSCENE_STEP
                                case 0 { set textQuoteRow1 209 set CUTSCENE_SPRITE DUKEHEADSPRITE set dont_stop_sounds 1 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 set curr_cuts_voc GM_SATLINK else set curr_cuts_voc GM_SATLINKEU } break }
                                case 1 set CUTSCENE_SPRITE SARGEHEADSPRITE break 
                                case 3 { set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 set curr_cuts_voc GM_ALGAEEATERS else set curr_cuts_voc GM_FAIRFIGHT } break }
                                case 4 { ife dna_dukecutscenevoc 2 { ife dna_localization 0 set curr_cuts_voc GM_WRONGPLANET else set curr_cuts_voc GM_STACKEDODDS } break }
                                endswitch
                        }
                        //LEVEL 2 GRAY SCENE
                        ifvare cutscene_num 1003
                        {
                                switch CUTSCENE_STEP
                                case 0 { set textQuoteRow1 229 set CUTSCENE_SPRITE DUKEHEADSPRITE set dont_stop_sounds 1 
                                        ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_CLOSEENCOUNTER break }
                                case 1 set CUTSCENE_SPRITE SARGEHEADSPRITE break 
                                case 2 { ife dna_localization 0 set skip_this_panel 1 set CUTSCENE_SPRITE SARGEHEADSPRITE break }
                                case 3 { set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 set curr_cuts_voc GM_WORKOVERTIME else set curr_cuts_voc GM_RESURRECTOVERTIME } break }
                                endswitch
                        }
                        break
                }
                case 2 //AKA Level 3 - Hybrid Army
                {
                        ifvare cutscene_num 1001
                        {
                                switch CUTSCENE_STEP
                                case 0 { set CUTSCENE_SPRITE DUKEHEADSPRITE
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_SUBWAYSYSTEM } else { set curr_cuts_voc GM_SUBWAYSYSTEMEU } } break }
                                case 1 set CUTSCENE_SPRITE SARGEHEADSPRITE break
                                case 2 { ife dna_localization 1 set skip_this_panel 1 break }
                                case 3 { set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_UNDEROURNOSES } else { set curr_cuts_voc GM_UNDEROURNOSESEU } } break }
                                case 4 set CUTSCENE_SPRITE SARGEHEADSPRITE break
                                case 5 { ife dna_localization 1 set skip_this_panel 1 break }
                                case 6 { ife dna_localization 1 set skip_this_panel 1 break }
                                case 7 { set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_DERAILPLANS } else { set curr_cuts_voc GM_DERAILED } } break }
                                case 8 { ife dna_localization 1 set skip_this_panel 1 
                                        ife dna_localization 0 { 
                                                ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_BUBBLEGUM  
                                                else { ife dna_dukecutscenevoc 1 set curr_cuts_voc WAR_AMBIENCE10 }
                                        }
                                        break 
                                        }
                                endswitch
                        }
                        //LEVEL 3 Destroyed Hybrid Army
                        ifvare cutscene_num 1002
                        {
                                switch CUTSCENE_STEP
                                case 0 { set textQuoteRow1 237 set CUTSCENE_SPRITE SARGEHEADSPRITE set dont_stop_sounds 1 break }
                                case 2 { setvar CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ifvare dna_dukecutscenevoc 2 { ifvare dna_localization 0 { set curr_cuts_voc GM_ALMOSTTOOEASY } else ifvare dna_localization 1 { set curr_cuts_voc GM_PIECEOFCAKE } }
                                        else ifvare dna_dukecutscenevoc 1 set curr_cuts_voc JIBBED_ACTOR6 break } 
                                endswitch
                        }
                        //LEVEL 3 Spiderlord Encounter
                        ifvare cutscene_num 1003
                        {
                                switch CUTSCENE_STEP
                                case 0 { set textQuoteRow1 249 set CUTSCENE_SPRITE BOSS1HEADSPRITE break }
                                case 1 { ife dna_localization 1 set skip_this_panel 1 break }
                                case 2 { set CUTSCENE_SPRITE DUKEHEADSPRITE
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_ALOTTATALK } else ifvare dna_localization 1 { set curr_cuts_voc GM_YOUANDWHATARMY } } break }
                                case 3 { ife dna_localization 0 set skip_this_panel 1 set CUTSCENE_SPRITE BOSS1HEADSPRITE break }
                                case 7 { set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_localization 1 { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_ALIENAUTOPSYEU }
                                        else { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_ALIENAUTOPSY else ife dna_dukecutscenevoc 1 set curr_cuts_voc DUKE_GETWEAPON2 } break }
                                case 8 { ife dna_localization 0 set skip_this_panel 1 
                                        ife dna_localization 1 { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_COMEGETSOME else ife dna_dukecutscenevoc 1 set curr_cuts_voc DUKE_GETWEAPON2 } break }
                                endswitch
                        }
                        //LEVEL 3 End Level Scene
                        ifvare cutscene_num 1004
                        {
                                switch CUTSCENE_STEP
                                case 0 { set textQuoteRow1 285 set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ifvare dna_dukecutscenevoc 2 { ifvare dna_localization 0 { set curr_cuts_voc GM_TIPOFICEBERG } else ifvare dna_localization 1 { set curr_cuts_voc GM_TIPOFICEBERGEU } } break }
                                case 1 set CUTSCENE_SPRITE SARGEHEADSPRITE break
                                case 2 { set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_TOOBUSYDYIN } else ifvare dna_localization 1 { set curr_cuts_voc GM_EVERYSECPRECIOUS } } break }
                                case 3 { ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_SEEWHEREITLEADS } else ifvare dna_localization 1 { set curr_cuts_voc GM_FOLLOWTHEIRTRAIL } } break }
                                case 4 { ife dna_localization 1 {       
                                                ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_HAILTOKING
                                                else ife dna_dukecutscenevoc 1 set curr_cuts_voc DUKE_GETWEAPON6 }
                                        else { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_TALKONOTHERSIDE } break }
                                endswitch
                        }
                        break
                }
                case 3 //AKA Level 4 - Temple of Amun
                {
                        ifvare cutscene_num 1001
                        {
                                switch CUTSCENE_STEP
                                case 0 {   set CUTSCENE_SPRITE SARGEHEADSPRITE break }
                                case 1 set CUTSCENE_SPRITE SARGEHEADSPRITE break
                                case 2 { ife dna_localization 1 set skip_this_panel 1 else set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 set curr_cuts_voc GM_EGYPTIAN } break }
                                endswitch
                        }
                        //LEVEL 4 MID LEVEL SCENE
                        ifvare cutscene_num 1002
                        {
                                switch CUTSCENE_STEP
                                case 0 { set textQuoteRow1 213 set CUTSCENE_SPRITE DUKEHEADSPRITE
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_WHEREHIDING } else ife dna_localization 1 { set curr_cuts_voc GM_READYTODEFROST } } break }
                                endswitch
                        }
                        break
                }
                case 4 //AKA Level 5 - Inner Sanctum
                {
                        
                        ifvare cutscene_num 1001
                        {
                                switch CUTSCENE_STEP
                                case 0 {   set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_ENTIREARMY } else ifvare dna_localization 1 { set curr_cuts_voc GM_ENTIREARMYEU } } break }
                                case 1 set CUTSCENE_SPRITE SARGEHEADSPRITE break
                                case 3 { set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_PERMANENTHIBERNATION } else ifvare dna_localization 1 { set curr_cuts_voc GM_ILLFINDSOMEANSWERS } } break }
                                endswitch
                        }

                        //LEVEL 5 MID LEVEL SCENE
                        ifvare cutscene_num 1002
                        {
                                switch CUTSCENE_STEP
                                case 0 { set textQuoteRow1 217 set CUTSCENE_SPRITE DUKEHEADSPRITE set dont_stop_sounds 1  
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_FOUNDSCHEMATICS } else ife dna_localization 1 { set curr_cuts_voc GM_FOUNDSCHEMATICSEU } } break }
                                case 1 { ife dna_localization 1 set skip_this_panel 1 break }
                                case 2 set CUTSCENE_SPRITE SARGEHEADSPRITE break
                                case 4 { set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_localization 1 { ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_ONMYWAY }
                                        else {
                                                ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_ROCKIN
                                                else ife dna_dukecutscenevoc 1 set curr_cuts_voc BONUS_SPEECH4 } break }
                                endswitch
                        }
                        break
                }
                case 5 //AKA Level 6 - The Controller
                {
                        ifvare cutscene_num 1001
                        {
                                switch CUTSCENE_STEP
                                case 0 {   set CUTSCENE_SPRITE SARGEHEADSPRITE break }
                                case 3 { ife dna_localization 1 set skip_this_panel 1 else set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 set curr_cuts_voc GM_SWITCHFLIPPER } break } 
                                endswitch
                        }
                        //LEVEL 6 Controller Encounter
                        ifvare cutscene_num 1002
                        {
                                switch CUTSCENE_STEP
                                case 0 { set textQuoteRow1 221 set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 set curr_cuts_voc GM_SCORPIONKING else set curr_cuts_voc GM_BIGBOSS } break }
                                case 1 { ife dna_localization 1 set skip_this_panel 1 else set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 set curr_cuts_voc GM_CASEOFCRABS } break }
                                case 2 set CUTSCENE_SPRITE BOSS2HEADSPRITE break
                                case 4 { ife dna_localization 1 set skip_this_panel 1 else set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ifvare dna_localization 0 { set curr_cuts_voc GM_HEARDTHATBEFORE } } break }
                                endswitch
                        }
                        //LEVEL 6 Boss Hint
                        ifvare cutscene_num 1003
                        {
                                switch CUTSCENE_STEP
                                case 0 { set textQuoteRow1 241 set CUTSCENE_SPRITE SARGEHEADSPRITE break }
                                case 2 { set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_CRUSTACEANCRETIN } else ife dna_localization 1 { set curr_cuts_voc GM_MUTANTMAGGOT } } break }
                                endswitch
                        }
                        //LEVEL 6
                        ifvare cutscene_num 1004
                        {
                                switch CUTSCENE_STEP
                                case 0 { set textQuoteRow1 253 ife dna_localization 1 set skip_this_panel 1 else set CUTSCENE_SPRITE SARGEHEADSPRITE set dont_stop_sounds 1 break }
                                case 1 { ife dna_localization 1 set skip_this_panel 1 else set CUTSCENE_SPRITE SARGEHEADSPRITE break }
                                case 2 { ife dna_localization 1 set skip_this_panel 1 else set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_localization 0 {
                                                ife dna_dukecutscenevoc 2 set curr_cuts_voc GM_DAMNIMGOOD
                                                else ife dna_dukecutscenevoc 1 set curr_cuts_voc JIBBED_ACTOR5
                                        } break }
                                endswitch
                        }
                        break
                }
                case 6 //AKA Level 7 - Temple Run
                {
                        ifvare cutscene_num 1001
                        {
                                switch CUTSCENE_STEP
                                case 0 {   set CUTSCENE_SPRITE SARGEHEADSPRITE break }
                                case 1 { set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ifvare dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_CRABCAKES } else ife dna_localization 1 { set curr_cuts_voc GM_SELFDESTRUCT } } break }
                                case 2 set CUTSCENE_SPRITE SARGEHEADSPRITE break
                                case 3 { set CUTSCENE_SPRITE DUKEHEADSPRITE 
                                        ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_TWOWONDERS } else ife dna_localization 1 { set curr_cuts_voc GM_BULLETSTOKILL } } break }
                                case 4 { ife dna_dukecutscenevoc 2 { ife dna_localization 0 { set curr_cuts_voc GM_ALIENTELE } else ife dna_localization 1 { set curr_cuts_voc GM_SHOOTMYWAY } } break }        
                                endswitch
                        }
