    redefinequote 250 
    redefinequote 251 
    redefinequote 252 
    redefinequote 253 
    redefinequote 254 
    redefinequote 255 
    redefinequote 256 
    redefinequote 257 
    redefinequote 258
    redefinequote 259
    redefinequote 260 
    redefinequote 261
    redefinequote 262 
    redefinequote 263 
    redefinequote 264
    redefinequote 265 
    redefinequote 266 
    redefinequote 267 
    redefinequote 268 
    redefinequote 269 
    redefinequote 270
    redefinequote 271
    redefinequote 272 
    redefinequote 273 
    redefinequote 274 
    redefinequote 275 
    redefinequote 276 
    redefinequote 277
    redefinequote 278 
    redefinequote 279 
    redefinequote 280 
    redefinequote 281
    //Mission objective
    redefinequote OBJECTIVE_QUOTE1 Escape
    redefinequote OBJECTIVE_QUOTE2 Run your ass off!
    redefinequote OBJECTIVE_QUOTE3 
    redefinequote OBJECTIVE_QUOTE4 
