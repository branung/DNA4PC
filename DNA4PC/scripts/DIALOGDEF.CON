    redefinequote OBJECTIVE_QUOTE2 Rescue Jenny 3. 
    redefinequote OBJECTIVE_QUOTE3 
    redefinequote OBJECTIVE_QUOTE4 
}
else ifvare LEVEL 16 //AKA Level 17 - Jenny 4
{
    redefinequote 200 
    redefinequote 201 We're picking up massive 
    redefinequote 202 heat signatures near your 
    redefinequote 203 current location.  
    redefinequote 204 
    redefinequote 205 You must be near 
    redefinequote 206 the engine room.
    redefinequote 207  
