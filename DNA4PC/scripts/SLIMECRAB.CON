actor SLIMECRABPROJECTILE SLIMECRABPROJECTILESTRENGTH enda

spriteflags SLIMECRAB 4194304

action CRABWALKING          0   4  5  1  16
action CRABSTANDING         0   1  5  1  10
action CRABATTACKING        23  4  1  1  20
action CRABDYING            34  5  1  1  8
action CRABDEADBODY         36  1  1  1  10
action CRABFROZEN           0   1  5  1  10
action CRABFLINCH           28  1  5  1  10
action CRABGROW             0   1  1  1  10

move CRABSTOPPED
move CRABWALKVEL 162
move CRABSHRUNKVELS 32

ai AICRABWAIT               CRABSTANDING CRABSTOPPED geth
ai AICRABSEEK               CRABWALKING CRABWALKVEL seekplayer
ai AICRABATTACKPLAYER       CRABATTACKING CRABSTOPPED faceplayer
ai AICRABDYING	            CRABDYING CRABSTOPPED geth
ai AICRABHIT                CRABFLINCH CRABSTOPPED faceplayer
ai AICRABFROZEN             CRABFROZEN CRABSTOPPED geth
ai AICRABSHRUNK             CRABWALKING CRABSHRUNKVELS fleeenemy
ai AICRABGROW               CRABGROW CRABSTOPPED geth

state crabhitstate
  ifcount 9 ai AICRABWAIT
ends

state crabwaitstate
	ifcount 30 ai AICRABSEEK
ends

state crabseekstate
  ifcansee ifpdistl 6144
  ifrnd 2
  {
    // add sound here
  }
  ifcount 10
  ifcansee ifpdistl 6144
  ifp palive
  {
    ifrnd 8 
    { 
      ai AICRABATTACKPLAYER
    }
  }

  ifrnd 4 ifpdistg 6144 ai AICRABWAIT
ends

state crabattackstate
  ifcount 19
  {
    ifcount 20
      ai AICRABSEEK
  }
  else
	ifcount 18
  {
    sound SLIMERATTACK
		shoot SLIMECRABPROJECTILE
  }
  else
	 ifactioncount 6
	   resetactioncount
ends


state crabgrowstate
  state genericgrowcode
  sizeto 255 192
ends

state crabshrunkstate
  ifcount SHRUNKDONECOUNT
    ai AICRABWAIT
  else
    ifcount SHRUNKCOUNT
    {
      sizeto 30 24
    }
  else
    state genericshrunkcode
ends

state crabfrozenstate
  ifcount THAWTIME
	{
		ai AICRABWAIT
		getlastpal
  }
  else
  ifcount FROZENDRIPTIME
  {
    ifactioncount 26
    {
      spawn WATERDRIP
      resetactioncount
    }
  }
  ifhitweapon
  {
    ifwasweapon FREEZEBLAST
    {
      strength 0
      break
    }
    addkills 1 
      // state enemy_death

    ifrnd 84
      spawn BLOODPOOL
        lotsofglass 30
    sound GLASS_BREAKING
    killit
  }
  ifp pfacing
    ifpdistl FROZENQUICKKICKDIST
      pkick
ends

useractor enemy SLIMECRAB SLIMECRABSTRENGTH

fall
state checksquished
ifai 0
{
	// play alert sound here
  cstat 257
	ai AICRABSEEK
}

ifai AICRABDYING
{
  strength 0
  ifwasweapon RPG
  {
    sound SQUISHED
    spawn BLOODPOOL
    state standard_jibs
    killit
  }
  ifwasweapon RADIUSEXPLOSION
  {
    sound SQUISHED
    spawn BLOODPOOL
    state standard_jibs
    killit
  }
  ifaction CRABDYING
  {
    ifactioncount 5
    {
      cstat 0
      globalsound THUD
      action CRABDEADBODY
      break
    }
  }    
  ifaction CRABDEADBODY
  {
    findnearspritez GREYREVIVEPROJECTILE GREYPROJECTILEREVIVEXY GREYPROJECTILEREVIVEZ temp
    ifn temp -1
    {
      addkills -1
      spawn TRANSPORTERSTAR
      cstat 257
      strength SLIMECRABSTRENGTH
      ai AICRABWAIT
      // play sound here
    }
    ifhitweapon
    {
      ifwasweapon RPG
      {
              sound SQUISHED
              spawn BLOODPOOL
              state standard_jibs
              killit
      }
      ifwasweapon RADIUSEXPLOSION
      {
        sound SQUISHED
        spawn BLOODPOOL
        state standard_jibs
        killit
      }
    }
    ifcount RESPAWNACTORTIME
    ifrespawn
    {
      addkills -1
      spawn TRANSPORTERSTAR
      cstat 257
      strength SLIMECRABSTRENGTH
      ai AICRABWAIT
      // play sound here
    }
  }
  break
}


ifai AICRABGROW { state crabgrowstate break }
ifai AICRABFROZEN { state crabfrozenstate break }
ifai AICRABSHRUNK state crabshrunkstate else
ifai AICRABWAIT state crabwaitstate else
ifai AICRABHIT state crabhitstate else
ifai AICRABATTACKPLAYER state crabattackstate else
ifai AICRABSEEK state crabseekstate





ifhitweapon
{
  //guts JIBS6 1
  //spawn BLOOD
  ifwasweapon SHRINKSPARK
  {
    ifstrength 600
    {
      sound ACTOR_SHRINKING
      ai AICRABSHRUNK
      // set shrunken 1
      break
    }
    else addstrength -60
  }
  else
  ifwasweapon GROWSPARK
    sound EXPANDERHIT
		//guts JIBS2 1
  ifdead
  {
    // ifwasweapon FREEZEBLAST
    // {
    //   sound SOMETHINGFROZE
    //   spritepal 1
    //   ai AICRABFROZEN
    //   strength 0
    //   // state freezeme
    //   break
    // }
    ifwasweapon GROWSPARK
    {
      cstat 0
      sound ACTOR_GROWING
      ai AICRABGROW
      break
    }
    addkills 1
    sound SLIM_DYING
    ai AICRABDYING
    //guts JIBS6 8
    ifspritepal 0 break
    ifwasweapon RPG
    {
      sound SQUISHED
      spawn BLOODPOOL
      killit
    }
    ifwasweapon RADIUSEXPLOSION
    {
      sound SQUISHED
      spawn BLOODPOOL
      killit
    }
    break
  }
  // play pain sound here
  ifrnd 2
    spawn BLOODPOOL
  ifai AICRABHIT nullop else
  ifai AICRABSHRUNK nullop else
  {
    ifrnd 16 
      ai AICRABHIT        
  }
}
enda

eventloadactor SLIMECRAB
  sizeat 30 24
enda