// Duke Nukem : Advance extra sound/gfx definitions
cutscene logo.ivf { }

music { id "intro" file "music/grabbag.ogg" }

basepalette 3 { raw { file "/palette/dna_3dr_pal.raw" } }
artfile { file "dna_3dr.art" }

include textures.def
include scripts/mainmenu.def
include scripts/keyconfiguration.def

// Shade6, "tan", lavaroom map4
fogpal 140 32 16 4
// Shade13, "piss yellow", map5/7 lava cracks and map17/18 lava sections
fogpal 141 48 40 0
// Shade1, "reddish tan", map8 backstage / map16 rightmost room
fogpal 142 32 8 4

tilefromtexture 26 { file "tiles/26.png" xoffset 0 yoffset -4 }
tilefromtexture 2536 { file "tiles/2536.png" xoffset -25 yoffset 15 }
tilefromtexture 2537 { file "tiles/2537.png" xoffset 15 yoffset 11 }
tilefromtexture 2538 { file "tiles/2538.png" xoffset 15 yoffset 11 }
tilefromtexture 2539 { file "tiles/2539.png" xoffset 15 yoffset 11 }
tilefromtexture 2540 { file "tiles/2540.png" xoffset 15 yoffset 11 }
tilefromtexture 2541 { file "tiles/2541.png" }
tilefromtexture 2542 { file "tiles/2542.png" }
tilefromtexture 2543 { file "tiles/2543.png" }

//Sky texture fixes
multipsky 3699 {
    lognumtiles 1
    yscale 65535
    yoffset 154
    horizfrac 65536
}
multipsky 3914 {
    lognumtiles 1
    yscale 65535
    yoffset 154
    horizfrac 65536
}
multipsky 3915 {
    lognumtiles 1
    yscale 65535
    yoffset 154
    horizfrac 65536
}